From: QiuSimons <45143996+QiuSimons@users.noreply.github.com>
Subject: [PATCH] luci-app-firewall: add BRCM full cone NAT option

Add BRCM Full Cone NAT option to Firewall - General Settings, controlling
the global 'fullcone4' and 'fullcone6' options in /etc/config/firewall.

Signed-off-by: QiuSimons <45143996+QiuSimons@users.noreply.github.com>
---

--- a/applications/luci-app-firewall/htdocs/luci-static/resources/view/firewall/zones.js
+++ b/applications/luci-app-firewall/htdocs/luci-static/resources/view/firewall/zones.js
@@ -53,6 +53,23 @@
 			uci.unset('firewall', section_id, 'syn_flood');
 			uci.unset('firewall', section_id, 'synflood_protect');
 		};
+		// BRCM Full Cone NAT
+		o = s.option(form.ListValue, "fullcone", _("BRCM Full Cone NAT"));
+		o.value('0', _("Disable"));
+		o.value('1', _("Enable IPv4"));
+		o.value('2', _("Enable IPv4 and IPv6"));
+		o.cfgvalue = function(section_id) {
+			/* fw4 declares both family switches with default 0, so an absent key
+			 * has to read as disabled. */
+			var v4 = (uci.get('firewall', section_id, 'fullcone4') === '1');
+			var v6 = (uci.get('firewall', section_id, 'fullcone6') === '1');
+
+			return v4 ? (v6 ? '2' : '1') : '0';
+		};
+		o.write = function(section_id, value) {
+			uci.set('firewall', section_id, 'fullcone4', (value === '1' || value === '2') ? '1' : '0');
+			uci.set('firewall', section_id, 'fullcone6', (value === '2') ? '1' : '0');
+		};
 
 		o = s.option(form.Flag, 'drop_invalid', _('Drop invalid packets'));
 
