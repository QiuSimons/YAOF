From: QiuSimons <45143996+QiuSimons@users.noreply.github.com>
Subject: [PATCH] firewall4: add BCM full-cone NAT support

Implement Broadcom expectation-based full-cone NAT support for firewall4:
- Attach BCM-NAT (IPv4) or BCM-NAT6 (IPv6) helper to connection prior to masquerade
- Add runtime kernel helper probing via nft_try_brcmfullcone()
- Add global fullcone4 and fullcone6 configuration options in defaults
- Insert brcmfullcone_srcnat chain at priority srcnat - 10 to ensure full-cone
  masquerade executes before other NAT hooks

Signed-off-by: QiuSimons <45143996+QiuSimons@users.noreply.github.com>
---

diff --git a/root/etc/config/firewall b/root/etc/config/firewall
--- a/root/etc/config/firewall
+++ b/root/etc/config/firewall
@@ -5,6 +5,8 @@
 	option forward		REJECT
 # Uncomment this line to disable ipv6 rules
 #	option disable_ipv6	1
+	option fullcone4	0
+	option fullcone6	0
 
 config zone
 	option name		lan
diff --git a/root/usr/share/firewall4/templates/ruleset.uc b/root/usr/share/firewall4/templates/ruleset.uc
--- a/root/usr/share/firewall4/templates/ruleset.uc
+++ b/root/usr/share/firewall4/templates/ruleset.uc
@@ -13,6 +13,7 @@
 {% fw4.includes('ruleset-prepend') %}
 
 table inet fw4 {
+{% let fullcone_zones = filter(fw4.zones(), zone => zone.fullcone4 || zone.fullcone6); %}
 {% if (length(flowtable_devices) > 0): %}
 	#
 	# Flowtable
@@ -44,6 +45,23 @@
 {%  endfor %}
 
 {% endif %}
+{% if (length(fullcone_zones)): %}
+	#
+	# BCM full-cone NAT helpers
+	#
+{%  if (length(filter(fullcone_zones, zone => zone.fullcone4))): %}
+	ct helper bcmfullcone4 {
+		type "BCM-NAT" protocol udp;
+	}
+
+{%  endif %}
+{%  if (length(filter(fullcone_zones, zone => zone.fullcone6))): %}
+	ct helper bcmfullcone6 {
+		type "BCM-NAT6" protocol udp;
+	}
+
+{%  endif %}
+{% endif %}
 {% if (length(defined_ipsets)): %}
 	#
 	# Set definitions
@@ -304,6 +322,23 @@
 {% fw4.includes('chain-append', 'dstnat') %}
 	}
 
+{% if (length(fullcone_zones)): %}
+	#
+	# BCM full-cone NAT postrouting chain
+	#
+	chain brcmfullcone_srcnat {
+		type nat hook postrouting priority srcnat - 10; policy accept;
+{%  for (let redirect in fw4.redirects("srcnat")): %}
+		{%+ include("redirect.uc", { fw4, zone: null, redirect }) %}
+{%  endfor %}
+{%  for (let zone in fullcone_zones): %}
+{%   for (let rule in zone.match_rules): %}
+		{%+ include("zone-jump.uc", { fw4, zone, rule, direction: "srcnat" }) %}
+{%   endfor %}
+{%  endfor %}
+	}
+
+{% endif %}
 	chain srcnat {
 		type nat hook postrouting priority srcnat; policy accept;
 {% fw4.includes('chain-prepend', 'srcnat') %}
@@ -337,17 +372,31 @@
 {%   for (let redirect in fw4.redirects(`srcnat_${zone.name}`)): %}
 		{%+ include("redirect.uc", { fw4, zone, redirect }) %}
 {%   endfor %}
-{%   if (zone.masq): %}
+{%   if (zone.masq && !zone.fullcone4): %}
+{%    for (let saddrs in zone.masq4_src_subnets): %}
+{%     for (let daddrs in zone.masq4_dest_subnets): %}
+		{%+ include("zone-masq.uc", { fw4, zone, family: 4, saddrs, daddrs, fullcone: false }) %}
+{%     endfor %}
+{%    endfor %}
+{%   endif %}
+{%   if (zone.masq6 && !zone.fullcone6): %}
+{%    for (let saddrs in zone.masq6_src_subnets): %}
+{%     for (let daddrs in zone.masq6_dest_subnets): %}
+		{%+ include("zone-masq.uc", { fw4, zone, family: 6, saddrs, daddrs, fullcone: false }) %}
+{%     endfor %}
+{%    endfor %}
+{%   endif %}
+{%   if (zone.fullcone4): %}
 {%    for (let saddrs in zone.masq4_src_subnets): %}
 {%     for (let daddrs in zone.masq4_dest_subnets): %}
-		{%+ include("zone-masq.uc", { fw4, zone, family: 4, saddrs, daddrs }) %}
+		{%+ include("zone-masq.uc", { fw4, zone, family: 4, saddrs, daddrs, fullcone: true }) %}
 {%     endfor %}
 {%    endfor %}
 {%   endif %}
-{%   if (zone.masq6): %}
+{%   if (zone.fullcone6): %}
 {%    for (let saddrs in zone.masq6_src_subnets): %}
 {%     for (let daddrs in zone.masq6_dest_subnets): %}
-		{%+ include("zone-masq.uc", { fw4, zone, family: 6, saddrs, daddrs }) %}
+		{%+ include("zone-masq.uc", { fw4, zone, family: 6, saddrs, daddrs, fullcone: true }) %}
 {%     endfor %}
 {%    endfor %}
 {%   endif %}
diff --git a/root/usr/share/firewall4/templates/zone-masq.uc b/root/usr/share/firewall4/templates/zone-masq.uc
--- a/root/usr/share/firewall4/templates/zone-masq.uc
+++ b/root/usr/share/firewall4/templates/zone-masq.uc
@@ -10,4 +10,8 @@
 	{{ fw4.ipproto(family) }} daddr != {{ fw4.set(map(daddrs[1], fw4.cidr)) }} {%+ endif -%}
 {%+ for (let a in (daddrs ? daddrs[2] : [])): -%}
 	{{ fw4.ipproto(family) }} daddr & {{ a.mask }} {{ a.invert ? '!=' : '==' }} {{ a.addr }} {%+ endfor -%}
+{%+ if (fullcone): -%}
+ct helper set "bcmfullcone{{ family }}" masquerade comment "!fw4: Handle {{ zone.name }} {{ fw4.nfproto(family, true) }} BCM full cone NAT srcnat traffic"
+{%+ else -%}
 masquerade comment "!fw4: Masquerade {{ fw4.nfproto(family, true) }} {{ zone.name }} traffic"
+{%+ endif -%}
diff --git a/root/usr/share/ucode/fw4.uc b/root/usr/share/ucode/fw4.uc
--- a/root/usr/share/ucode/fw4.uc
+++ b/root/usr/share/ucode/fw4.uc
@@ -490,6 +490,25 @@
 }
 
 
+function nft_try_brcmfullcone(family, loud) {
+	/* Probe whether the kernel supports BCM-NAT / BCM-NAT6 helpers */
+	let name = 'fw4-brcmfullcone-test';
+	let helper = (family == 6) ? 'BCM-NAT6' : 'BCM-NAT';
+	let cmd = sprintf("/usr/sbin/nft delete table inet %s 2>/dev/null; " +
+			  "/usr/sbin/nft 'add table inet %s; " +
+			  "add chain inet %s srcnat { type nat hook postrouting priority srcnat; policy accept; }; " +
+			  "add rule inet %s srcnat iifname \"fcprobe-never\" masquerade; " +
+			  "add ct helper inet %s probe { type \"%s\" protocol udp; }; " +
+			  "delete table inet %s' 2>/dev/null",
+			  name, name, name, name, name, helper, name);
+
+	if (system(cmd) == 0)
+		return true;
+
+	if (loud)
+		warn("nft_try_brcmfullcone: IPv" + (family == 6 ? "6" : "4") + " not supported\n");
+	return false;
+}
 return {
 	read_kernel_version: function() {
 		let fd = fs.open("/proc/version", "r"),
@@ -1946,6 +1965,9 @@
 		}
 
 		let defs = this.parse_options(data, {
+			nat6: [ "bool", "0" ],
+			fullcone4: [ "bool", "0" ],
+			fullcone6: [ "bool", "0" ],
 			input: [ "policy", "drop" ],
 			output: [ "policy", "drop" ],
 			forward: [ "policy", "drop" ],
@@ -1980,6 +2002,16 @@
 
 		delete defs.syn_flood;
 
+		/* Probe and apply BCM full-cone NAT defaults */
+		if (defs.fullcone4 && !nft_try_brcmfullcone(4, true)) {
+			this.warn_section(data, "kernel has no IPv4 BRCM full cone NAT support, disabling fullcone4");
+			defs.fullcone4 = 0;
+		}
+		if (defs.fullcone6 && !nft_try_brcmfullcone(6, true)) {
+			this.warn_section(data, "kernel has no IPv6 BRCM full cone NAT support, disabling fullcone6");
+			defs.fullcone6 = 0;
+		}
+
 		this.state.defaults = defs;
 	},
 
@@ -2004,6 +2036,8 @@
 			masq_dest: [ "network", null, PARSE_LIST ],
 
 			masq6: [ "bool" ],
+			fullcone4: [ "bool", "0" ],
+			fullcone6: [ "bool", "0" ],
 
 			extra: [ "string", null, UNSUPPORTED ],
 			extra_src: [ "string", null, UNSUPPORTED ],
@@ -2036,6 +2070,14 @@
 			}
 		}
 
+		if (this.state.defaults) {
+			/* Apply global full-cone setting to masquerading zones */
+			zone.fullcone4 = this.state.defaults.fullcone4 && zone.masq;
+			zone.fullcone6 = this.state.defaults.fullcone6 &&
+				(zone.masq6 || (zone.masq && this.state.defaults.nat6));
+		}
+
+
 		if (zone.mtu_fix && this.kernel < 0x040a0000) {
 			this.warn_section(data, "option 'mtu_fix' requires kernel 4.10 or later");
 			return;
@@ -2205,10 +2247,15 @@
 		zone.related_subnets = related_subnets;
 		zone.related_physdevs = related_physdevs;
 
-		if (zone.masq || zone.masq6)
+		if (zone.fullcone4 || zone.fullcone6 || zone.masq || zone.masq6)
 			zone.dflags.snat = true;
 
-		if ((zone.auto_helper && !(zone.masq || zone.masq6)) || length(zone.helper)) {
+		/* A full cone zone does its own masquerade, so the generic
+		 * "accept port redirections" rule is not wanted here. */
+		if (zone.fullcone4 || zone.fullcone6)
+			zone.dflags.dnat = false;
+
+		if ((zone.auto_helper && !(zone.masq || zone.masq6 || zone.fullcone4 || zone.fullcone6)) || length(zone.helper)) {
 			zone.dflags.helper = true;
 
 			for (let helper in (length(zone.helper) ? zone.helper : this.state.helpers)) {
