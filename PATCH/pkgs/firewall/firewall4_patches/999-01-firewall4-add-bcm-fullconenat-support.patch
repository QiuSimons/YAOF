From: YAOF-1 <dev@localhost>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] firewall4: add BCM full-cone NAT support

Full-cone NAT is provided by the Broadcom expectation-based scheme only:

  * fw4 attaches the kernel helper to the connection ("ct helper set") in
    front of the masquerade statement; the kernel then registers the matching
    expectation.  The nftables keyword and its netlink attribute are gone, so
    nftables and libnftnl need no patches at all.
  * nft_try_brcmfullcone(family) probes one family at a time by creating a
    ct helper object, which nft resolves against the kernel helper table; a
    kernel without BCM-NAT/BCM-NAT6 disables exactly that family
  * defaults.fullcone4 / defaults.fullcone6 are the switches themselves
    (both off by default); there is no separate global master switch, and
    zones cannot shadow them any more
  * a zone qualifies when it masquerades - for IPv6 also when masq6 is
    implied by the "nat6" defaults switch, i.e. when the external nat6
    service translates the zone
  * the zone srcnat rules are also emitted into a postrouting chain at
    "priority srcnat - 10" so they run before any other NAT chain at
    the canonical srcnat priority (the nat6 service installs one).  The
    full cone masquerade has to perform the NAT itself to register the
    expectation, so that ordering is what ties it to the right statement.
    The extra chain only exists when a zone has a full cone family
    enabled.

The nft-fullcone scheme (nft_try_fullcone, zone-fullcone.uc, defaults.fullcone,
the fw4.default_option("brcmfullcone") branches) is gone: brcmfullcone is an
upper replacement and keeping both only made the ruleset pick between two
schemes.

Signed-off-by: YAOF-1 <dev@localhost>
---
diff --git a/root/etc/config/firewall b/root/etc/config/firewall
index 48b2440..37186f2 100644
--- a/root/etc/config/firewall
+++ b/root/etc/config/firewall
@@ -5,6 +5,8 @@ config defaults
 	option forward		REJECT
 # Uncomment this line to disable ipv6 rules
 #	option disable_ipv6	1
+	option fullcone4	0
+	option fullcone6	0
 
 config zone
 	option name		lan
diff --git a/root/usr/share/firewall4/templates/ruleset.uc b/root/usr/share/firewall4/templates/ruleset.uc
index 2bec4d9..e31d2ed 100644
--- a/root/usr/share/firewall4/templates/ruleset.uc
+++ b/root/usr/share/firewall4/templates/ruleset.uc
@@ -13,6 +13,7 @@ delete flowtable inet fw4 ft
 {% fw4.includes('ruleset-prepend') %}
 
 table inet fw4 {
+{% let fullcone_zones = filter(fw4.zones(), zone => zone.fullcone4 || zone.fullcone6); %}
 {% if (length(flowtable_devices) > 0): %}
 	#
 	# Flowtable
@@ -43,6 +44,25 @@ table inet fw4 {
 {%   endfor %}
 {%  endfor %}
 
+{% endif %}
+{% if (length(fullcone_zones)): %}
+	#
+	# BCM full cone: the helper attached to a connection is what makes the
+	# masquerade below register an expectation, so one object per family.
+	# Creating them also proves the kernel carries the helper.
+	#
+{%  if (length(filter(fullcone_zones, zone => zone.fullcone4))): %}
+	ct helper bcmfullcone4 {
+		type "BCM-NAT" protocol udp;
+	}
+
+{%  endif %}
+{%  if (length(filter(fullcone_zones, zone => zone.fullcone6))): %}
+	ct helper bcmfullcone6 {
+		type "BCM-NAT6" protocol udp;
+	}
+
+{%  endif %}
 {% endif %}
 {% if (length(defined_ipsets)): %}
 	#
@@ -304,6 +324,27 @@ table inet fw4 {
 {% fw4.includes('chain-append', 'dstnat') %}
 	}
 
+{% if (length(fullcone_zones)): %}
+	#
+	# A full cone expectation is only registered by the masquerade statement
+	# which actually performs the NAT, so the zone srcnat rules must run before
+	# every other NAT postrouting chain at priority srcnat (such as the one the
+	# external nat6 service installs).  Evaluate them a second time from a lower
+	# priority hook; the regular srcnat chain below is a no-op then.
+	#
+	chain brcmfullcone_srcnat {
+		type nat hook postrouting priority srcnat - 10; policy accept;
+{%  for (let redirect in fw4.redirects("srcnat")): %}
+		{%+ include("redirect.uc", { fw4, zone: null, redirect }) %}
+{%  endfor %}
+{%  for (let zone in fullcone_zones): %}
+{%   for (let rule in zone.match_rules): %}
+		{%+ include("zone-jump.uc", { fw4, zone, rule, direction: "srcnat" }) %}
+{%   endfor %}
+{%  endfor %}
+	}
+
+{% endif %}
 	chain srcnat {
 		type nat hook postrouting priority srcnat; policy accept;
 {% fw4.includes('chain-prepend', 'srcnat') %}
@@ -337,20 +378,26 @@ table inet fw4 {
 {%   for (let redirect in fw4.redirects(`srcnat_${zone.name}`)): %}
 		{%+ include("redirect.uc", { fw4, zone, redirect }) %}
 {%   endfor %}
-{%   if (zone.masq): %}
+{%   if (zone.masq && !zone.fullcone4): %}
 {%    for (let saddrs in zone.masq4_src_subnets): %}
 {%     for (let daddrs in zone.masq4_dest_subnets): %}
 		{%+ include("zone-masq.uc", { fw4, zone, family: 4, saddrs, daddrs }) %}
 {%     endfor %}
 {%    endfor %}
 {%   endif %}
-{%   if (zone.masq6): %}
+{%   if (zone.masq6 && !zone.fullcone6): %}
 {%    for (let saddrs in zone.masq6_src_subnets): %}
 {%     for (let daddrs in zone.masq6_dest_subnets): %}
 		{%+ include("zone-masq.uc", { fw4, zone, family: 6, saddrs, daddrs }) %}
 {%     endfor %}
 {%    endfor %}
 {%   endif %}
+{%   if (zone.fullcone4): %}
+		meta nfproto ipv4 ct helper set "bcmfullcone4" masquerade comment "!fw4: Handle {{ zone.name }} IPv4 BCM full cone NAT srcnat traffic"
+{%   endif %}
+{%   if (zone.fullcone6): %}
+		meta nfproto ipv6 ct helper set "bcmfullcone6" masquerade comment "!fw4: Handle {{ zone.name }} IPv6 BCM full cone NAT srcnat traffic"
+{%   endif %}
 {%   fw4.includes('chain-append', `srcnat_${zone.name}`) %}
 	}
 
diff --git a/root/usr/share/ucode/fw4.uc b/root/usr/share/ucode/fw4.uc
index a0d8e4f..fdb8787 100644
--- a/root/usr/share/ucode/fw4.uc
+++ b/root/usr/share/ucode/fw4.uc
@@ -490,6 +490,33 @@ function nft_try_hw_offload(devices) {
 }
 
 
+function nft_try_brcmfullcone(family, loud) {
+	/*
+	 * nft resolves a ct helper object against the kernel helper table when
+	 * the object is created, so this fails cleanly on a kernel that does
+	 * not carry BCM-NAT (IPv4) or BCM-NAT6 (IPv6).  The scratch NAT chain
+	 * and its rule make sure nf_nat/nft_masq are loaded first: the helpers
+	 * are registered from nf_nat_init(), and the object has to find them.
+	 * The rule matches a device name that cannot exist, so it can never NAT
+	 * live traffic while the scratch table is installed.
+	 */
+	let name = 'fw4-brcmfullcone-test';
+	let helper = (family == 6) ? 'BCM-NAT6' : 'BCM-NAT';
+	let cmd = sprintf("/usr/sbin/nft delete table inet %s 2>/dev/null; " +
+			  "/usr/sbin/nft 'add table inet %s; " +
+			  "add chain inet %s srcnat { type nat hook postrouting priority srcnat; policy accept; }; " +
+			  "add rule inet %s srcnat iifname \"fcprobe-never\" masquerade; " +
+			  "add ct helper inet %s probe { type \"%s\" protocol udp; }; " +
+			  "delete table inet %s' 2>/dev/null",
+			  name, name, name, name, name, helper, name);
+
+	if (system(cmd) == 0)
+		return true;
+
+	if (loud)
+		warn("nft_try_brcmfullcone: IPv" + (family == 6 ? "6" : "4") + " not supported\n");
+	return false;
+}
 return {
 	read_kernel_version: function() {
 		let fd = fs.open("/proc/version", "r"),
@@ -1946,6 +1973,9 @@ return {
 		}
 
 		let defs = this.parse_options(data, {
+			nat6: [ "bool", "0" ],
+			fullcone4: [ "bool", "0" ],
+			fullcone6: [ "bool", "0" ],
 			input: [ "policy", "drop" ],
 			output: [ "policy", "drop" ],
 			forward: [ "policy", "drop" ],
@@ -1980,6 +2010,21 @@ return {
 
 		delete defs.syn_flood;
 
+		/*
+		 * fullcone4 / fullcone6 are the switches themselves - there is no
+		 * separate global master switch.  Probe the kernel per family, and only
+		 * for a family that was actually asked for, so a kernel without the
+		 * BCM helper disables exactly the family it cannot do.
+		 */
+		if (defs.fullcone4 && !nft_try_brcmfullcone(4, true)) {
+			this.warn_section(data, "kernel has no IPv4 BRCM full cone NAT support, disabling fullcone4");
+			defs.fullcone4 = 0;
+		}
+		if (defs.fullcone6 && !nft_try_brcmfullcone(6, true)) {
+			this.warn_section(data, "kernel has no IPv6 BRCM full cone NAT support, disabling fullcone6");
+			defs.fullcone6 = 0;
+		}
+
 		this.state.defaults = defs;
 	},
 
@@ -2004,6 +2049,8 @@ return {
 			masq_dest: [ "network", null, PARSE_LIST ],
 
 			masq6: [ "bool" ],
+			fullcone4: [ "bool", "0" ],
+			fullcone6: [ "bool", "0" ],
 
 			extra: [ "string", null, UNSUPPORTED ],
 			extra_src: [ "string", null, UNSUPPORTED ],
@@ -2036,6 +2083,15 @@ return {
 			}
 		}
 
+		if (this.state.defaults) {
+			/* the switches are global only: a zone key left over from an older
+			 * configuration must not be able to shadow them */
+			zone.fullcone4 = this.state.defaults.fullcone4 && zone.masq;
+			zone.fullcone6 = this.state.defaults.fullcone6 &&
+				(zone.masq6 || (zone.masq && this.state.defaults.nat6));
+		}
+
+
 		if (zone.mtu_fix && this.kernel < 0x040a0000) {
 			this.warn_section(data, "option 'mtu_fix' requires kernel 4.10 or later");
 			return;
@@ -2205,10 +2261,18 @@ return {
 		zone.related_subnets = related_subnets;
 		zone.related_physdevs = related_physdevs;
 
+		if (zone.fullcone4 || zone.fullcone6) {
+			zone.dflags.snat = true;
+			zone.dflags.dnat = true;
+		}
+
 		if (zone.masq || zone.masq6)
 			zone.dflags.snat = true;
 
-		if ((zone.auto_helper && !(zone.masq || zone.masq6)) || length(zone.helper)) {
+		if (zone.fullcone4 || zone.fullcone6)
+			zone.dflags.dnat = false;
+
+		if ((zone.auto_helper && !(zone.masq || zone.masq6 || zone.fullcone4 || zone.fullcone6)) || length(zone.helper)) {
 			zone.dflags.helper = true;
 
 			for (let helper in (length(zone.helper) ? zone.helper : this.state.helpers)) {
