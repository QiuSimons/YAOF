#!/bin/sh /etc/rc.common

START=70

ACCT_SYSCTL=/proc/sys/net/netfilter/nf_conntrack_acct
ACCT_STATE=/var/run/sfe_conntrack_acct

start() {
	# Check if Shortcut-FE is enabled in firewall configuration
	[ "$(uci -q get firewall.@defaults[0].shortcut_fe)" != "1" ] && return 0

	# Retrieve optional configuration from UCI firewall.@defaults[0].  Fall back
	# to the module defaults when the options are absent or empty, and coerce
	# anything unparsable - a bad value would otherwise make modprobe fail
	# without a trace.
	local delay_pkts="$(uci -q get firewall.@defaults[0].sfe_delay_pkts)"
	local fast_xmit="$(uci -q get firewall.@defaults[0].sfe_fast_xmit)"

	case "$delay_pkts" in
		''|*[!0-9]*) delay_pkts=8 ;;
	esac
	case "$fast_xmit" in
		''|0) fast_xmit=0 ;;
		*) fast_xmit=1 ;;
	esac

	# delay_pkts is evaluated through the conntrack accounting extension, which is
	# only added to connections allocated while accounting is on.  The module
	# enables it by itself when a window is used and restores it on unload; doing
	# it here as well gets it in place before the very first connection, and with
	# delay_pkts=0 nothing is touched at all.
	if [ "$delay_pkts" != "0" ] && [ -r "$ACCT_SYSCTL" ]; then
		cat "$ACCT_SYSCTL" > "$ACCT_STATE" 2>/dev/null
		echo 1 > "$ACCT_SYSCTL" 2>/dev/null
		if [ "$(cat "$ACCT_SYSCTL" 2>/dev/null)" != "1" ]; then
			logger -t shortcut-fe "conntrack accounting unavailable: delay_pkts=$delay_pkts will be ignored"
		fi
	fi

	# Load SFE v2 engine and connection manager modules
	modprobe qca-nss-sfe || logger -t shortcut-fe "failed to load qca-nss-sfe"
	modprobe shortcut-fe-cm "delay_pkts=$delay_pkts" "fast_xmit=$fast_xmit" || \
		logger -t shortcut-fe "failed to load shortcut-fe-cm delay_pkts=$delay_pkts fast_xmit=$fast_xmit"

	# Optimize TCP conntrack behavior for SFE
	echo 1 > /proc/sys/net/netfilter/nf_conntrack_tcp_be_liberal 2>/dev/null
}

stop() {
	# Unload connection manager and engine modules cleanly
	rmmod shortcut-fe-cm 2>/dev/null || rmmod shortcut_fe_cm 2>/dev/null
	rmmod qca-nss-sfe 2>/dev/null || rmmod qca_nss_sfe 2>/dev/null

	# Reset TCP conntrack setting
	echo 0 > /proc/sys/net/netfilter/nf_conntrack_tcp_be_liberal 2>/dev/null

	# Put connection tracking accounting back the way we found it, otherwise
	# every connection keeps paying for counters nothing reads anymore.
	if [ -r "$ACCT_STATE" ]; then
		read -r acct_prev < "$ACCT_STATE"
		[ -n "$acct_prev" ] && echo "$acct_prev" > "$ACCT_SYSCTL" 2>/dev/null
		rm -f "$ACCT_STATE"
	fi
}

restart() {
	stop
	start
}
