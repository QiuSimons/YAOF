#!/bin/sh
#
# SFE v2 Debug Dump Utility
#
sfe_dump(){
	[ -e "/dev/sfe_ipv4" ] || {
		dev_num=$(cat /sys/sfe_ipv4/debug_dev 2>/dev/null)
		[ -n "$dev_num" ] && mknod /dev/sfe_ipv4 c $dev_num 0
	}
	[ -e "/dev/sfe_ipv6" ] || {
		dev_num=$(cat /sys/sfe_ipv6/debug_dev 2>/dev/null)
		[ -n "$dev_num" ] && mknod /dev/sfe_ipv6 c $dev_num 0
	}
	cat /dev/sfe_$1 2>/dev/null
}

# Connection manager summary (effective parameters and counters).  The engine's
# own exception counters are part of the XML dump below.
if [ -z "$1" ]; then
	[ -r /sys/module/shortcut_fe_cm/parameters/status ] && \
		cat /sys/module/shortcut_fe_cm/parameters/status
	sfe_dump ipv4
	sfe_dump ipv6
else
	sfe_dump $1
fi
