From 7c1e5a88294a2176b6d859187ec51f5010b91cb2 Mon Sep 17 00:00:00 2001
From: QiuSimons <45143996+QiuSimons@users.noreply.github.com>
Date: Fri, 23 Oct 2026 12:30:00 +0800
Subject: [PATCH 20/20] net-tcp_bbr: add adaptive LFN loss tolerance via pernet
 sysctl

Paths with high bandwidth-delay products (satellite, wireless, WAN)
frequently suffer from random, non-congestive physical loss (e.g. 2-5%).
Stock BBRv3 maintains a fixed 2% loss threshold. When physical loss
exceeds this threshold, BBRv3 treats it as congestion, repeatedly
capping inflight_hi and cutting lower bounds, causing severe throughput
degradation on long-fat networks.

This patch adds an adaptive LFN loss tolerance mechanism to tcp_bbr:

- Learns an uncongested physical loss floor via EWMA during steady-state
  CRUISE rounds when RTT is flat (srtt < 1.2 * min_rtt) and inflight is
  within 1.15x pure BDP.
- Adapts loss threshold to min(floor + 1.0%, 8.0%). On clean paths with
  no physical loss, the threshold remains at stock 2.0%.
- Restricts tolerance strictly to non-probing phases. Active bandwidth
  probing samples and queue buildup are never exempted.
- Over-threshold losses still cut inflight_hi normally; exempt rounds
  skip lower-bound reduction without pinning inflight_lo.
- Implemented per-netns via tcp_bbr sysctl without modifying global
  tcp structs or sysctl tables:
    net.ipv4.tcp_bbr_lfn_loss_thresh_pct (0=off, 1=auto, 2-8=manual)
    net.ipv4.tcp_bbr_lfn_min_rtt_fresh_ms (default 15000)

Default is set to 1 (auto mode).

Signed-off-by: QiuSimons <45143996+QiuSimons@users.noreply.github.com>
---
 net/ipv4/tcp_bbr.c | 386 +++++++++++++++++++++++++++++++++++++++++++--
 1 file changed, 380 insertions(+), 6 deletions(-)

--- a/net/ipv4/tcp_bbr.c
+++ b/net/ipv4/tcp_bbr.c
@@ -60,6 +60,10 @@
 #include <linux/btf.h>
 #include <linux/btf_ids.h>
 #include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/sysctl.h>
+#include <net/net_namespace.h>
+#include <net/netns/generic.h>
 #include <net/tcp.h>
 #include <linux/inet_diag.h>
 #include <linux/inet.h>
@@ -85,6 +89,16 @@
 #define BBR_SCALE 8	/* scaling factor for fractions in BBR (e.g. gains) */
 #define BBR_UNIT (1 << BBR_SCALE)
 
+/* Opt-in tolerance for non-congestive loss on long-fat paths.
+ * 0 disables. See bbr_lfn_* below. Values are tenths of a percent.
+ */
+#define BBR_LFN_MIN_PATH_RTT_US	10000	/* ignore DC / short paths */
+#define BBR_LFN_MIN_TX		16	/* min packets in a ratio sample */
+#define BBR_LFN_POISON_TX	64	/* smaller flights must not veto a round */
+#define BBR_LFN_CAP_TENTHS	80	/* hard cap: 8.0% */
+#define BBR_LFN_STOCK_TENTHS	20	/* BBRv3 loss_thresh: 2.0% */
+#define BBR_LFN_MARGIN_TENTHS	10	/* auto: floor + 1.0% */
+
 /* BBR has the following modes for deciding how fast to send: */
 enum bbr_mode {
 	BBR_STARTUP,	/* ramp up sending rate rapidly to fill pipe */
@@ -120,14 +134,17 @@
 		idle_restart:1,	     /* restarting after idle? */
 		probe_rtt_round_done:1,  /* a BBR_PROBE_RTT round at 4 pkts? */
 		init_cwnd:7,         /* initial cwnd */
-		unused_1:10;
+		lfn_floor:8,	/* uncongested loss floor, 0.1% units */
+		lfn_round_probe:1, /* loss-round overlapped a bw probe */
+		lfn_round_congested:1; /* loss-round saw RTT >= 1.2*min */
 	u32	pacing_gain:10,	/* current gain for setting pacing rate */
 		cwnd_gain:10,	/* current gain for setting cwnd */
 		full_bw_reached:1,   /* reached full bw in Startup? */
 		full_bw_cnt:2,	/* number of rounds without large bw gains */
 		cycle_idx:2,	/* current index in pacing_gain cycle array */
 		has_seen_rtt:1, /* have we seen an RTT sample yet? */
-		unused_2:6;
+		lfn_round:5,	/* this loss-round loss rate, 0.5% units */
+		lfn_round_over:1;	/* a sample in this round exceeded LFN cap */
 	u32	prior_cwnd;	/* prior cwnd upon entering loss recovery */
 	u32	full_bw;	/* recent bw, to estimate if pipe is full */
 
@@ -142,7 +159,7 @@
 		startup_ecn_rounds:2,	/* consecutive hi ECN STARTUP rounds */
 		loss_in_cycle:1,	/* packet loss in this cycle? */
 		ecn_in_cycle:1,		/* ECN in this cycle? */
-		unused_3:1;
+		lfn_round_valid:1;	/* lfn_round has a real sample */
 	u32	loss_round_delivered; /* scb->tx.delivered ending loss round */
 	u32	undo_bw_lo;	     /* bw_lo before latest losses */
 	u32	undo_inflight_lo;    /* inflight_lo before latest losses */
@@ -1164,12 +1181,270 @@
 		bbr_raise_inflight_hi_slope(sk);
 }
 
+/* ----- opt-in LFN loss tolerance ------------------------------------
+ *
+ * Physical loss on a long-fat path (satellite, some cross-border WANs) is
+ * not a congestion signal, but BBRv3 still:
+ *   - treats loss above 2% as "inflight too high" (freezes inflight_hi,
+ *     and can leave STARTUP), and
+ *   - cuts bw_lo/inflight_lo on any loss in a non-probing round.
+ *
+ * This is off unless net.ipv4.tcp_bbr_lfn_loss_thresh_pct is non-zero.
+ * It never raises the ECN threshold. A sample (or round) at or under the
+ * tolerated loss rate is treated as not-too-high; anything above it takes
+ * the stock backoff, including during PROBE_UP / bw_probe_samples.
+ * The tolerated rate is decided before this round's sample is folded into
+ * the floor, so a spike cannot excuse itself.
+ *
+ * pct sysctl: 0 off, 1 auto (learn the uncongested floor, cap 8%),
+ *             2..8 manual ceiling in percent.
+ */
+
+struct bbr_net {
+	struct ctl_table_header *hdr;
+#ifdef CONFIG_SYSCTL
+	struct ctl_table *table;
+#endif
+	int loss_thresh_pct;
+	int min_rtt_fresh_ms;
+};
+
+static unsigned int bbr_net_id;
+static const int bbr_lfn_pct_max = 8;
+static const int bbr_lfn_fresh_max = 60000;
+
+static struct bbr_net *bbr_net(const struct sock *sk)
+{
+	return net_generic(sock_net(sk), bbr_net_id);
+}
+
+static int bbr_lfn_pct(const struct sock *sk)
+{
+	return READ_ONCE(bbr_net(sk)->loss_thresh_pct);
+}
+
+static u32 bbr_lfn_fresh_ms(const struct sock *sk)
+{
+	return READ_ONCE(bbr_net(sk)->min_rtt_fresh_ms);
+}
+
+/* Threshold in 0.1% units. 0 means the feature is off. */
+static u32 bbr_lfn_thresh_tenths(const struct sock *sk)
+{
+	const struct bbr *bbr = inet_csk_ca(sk);
+	int pct = bbr_lfn_pct(sk);
+	u32 floor, thresh;
+
+	if (pct <= 0)
+		return 0;
+	if (pct > 1)
+		return (u32)min_t(int, pct, bbr_lfn_pct_max) * 10;
+
+	/* Auto. Stay at the stock 2% until the learned floor exceeds it. */
+	floor = bbr->lfn_floor;
+	if (floor + BBR_LFN_MARGIN_TENTHS <= BBR_LFN_STOCK_TENTHS)
+		return BBR_LFN_STOCK_TENTHS;
+	thresh = floor + BBR_LFN_MARGIN_TENTHS;
+	return min_t(u32, thresh, BBR_LFN_CAP_TENTHS);
+}
+
+static bool bbr_lfn_min_rtt_fresh(const struct sock *sk)
+{
+	const struct bbr *bbr = inet_csk_ca(sk);
+	u32 limit_ms = bbr_lfn_fresh_ms(sk);
+
+	if (!limit_ms)
+		return true;
+	if (!bbr->min_rtt_stamp)
+		return false;
+	return jiffies_to_msecs(tcp_jiffies32 - bbr->min_rtt_stamp) <= limit_ms;
+}
+
+/* Prefer this ACK's RTT. skb_marked_lost has no rate-sample RTT; srtt is
+ * the best signal that the path is not currently queued.
+ */
+static bool bbr_lfn_rtt_flat(const struct sock *sk, const struct rate_sample *rs)
+{
+	const struct bbr *bbr = inet_csk_ca(sk);
+	long rtt = rs->rtt_us;
+
+	if (bbr->min_rtt_us == 0 || bbr->min_rtt_us == ~0U)
+		return false;
+	if (bbr->min_rtt_us < BBR_LFN_MIN_PATH_RTT_US)
+		return false;
+	if (rtt <= 0) {
+		u32 srtt = tcp_sk(sk)->srtt_us >> 3;
+
+		if (!srtt)
+			return false;
+		rtt = srtt;
+	}
+	return (u64)rtt * 5 < (u64)bbr->min_rtt_us * 6;
+}
+
+static bool bbr_lfn_probing_now(const struct bbr *bbr)
+{
+	return bbr->bw_probe_samples ||
+	       bbr->mode == BBR_STARTUP ||
+	       (bbr->mode == BBR_PROBE_BW &&
+		(bbr->cycle_idx == BBR_BW_PROBE_UP ||
+		 bbr->cycle_idx == BBR_BW_PROBE_REFILL));
+}
+
+/* True when this loss sample should not count as inflight-too-high.
+ * Read-only: the floor is not updated here.
+ */
+static bool bbr_lfn_loss_tolerated(struct sock *sk, const struct rate_sample *rs)
+{
+	struct bbr *bbr = inet_csk_ca(sk);
+	u32 thresh, tenths, pipe, roof;
+
+	thresh = bbr_lfn_thresh_tenths(sk);
+	if (!thresh)
+		return false;
+	/* Any over-cap sample, or any queued RTT, this round: stock response.
+	 * One spike costs one round of tolerance. That is the safe direction.
+	 */
+	if (bbr->lfn_round_over || bbr->lfn_round_congested)
+		return false;
+	if (!bbr_lfn_min_rtt_fresh(sk) || !bbr_lfn_rtt_flat(sk, rs))
+		return false;
+	if (!rs->tx_in_flight || rs->tx_in_flight < BBR_LFN_MIN_TX)
+		return false;
+
+	tenths = ((u64)rs->lost * 1000) / rs->tx_in_flight;
+	if (tenths > thresh)
+		return false;
+	/* Partial round already shows more loss than we tolerate. */
+	if (bbr->lfn_round_valid &&
+	    (u32)bbr->lfn_round * 5 > thresh)
+		return false;
+
+	/* STARTUP and bw probes are supposed to exceed BDP. Everywhere else,
+	 * a flight well above the pipe is self-inflicted, not radio loss.
+	 */
+	if (!bbr_lfn_probing_now(bbr)) {
+		pipe = bbr_inflight(sk, bbr_max_bw(sk), BBR_UNIT);
+		roof = ((u64)pipe * 115) / 100;
+		if (rs->tx_in_flight > roof)
+			return false;
+	}
+	return true;
+}
+
+/* Round aggregate is within tolerance. Used for the once-per-round bw_lo cut,
+ * which upstream applies on any loss, not at the 2% inflight threshold.
+ * Does not look at a single ACK's rs->lost (that ACK is often not the
+ * lossy one). One sample above the hard cap poisons the round.
+ */
+static bool bbr_lfn_round_exempt(struct sock *sk, const struct rate_sample *rs)
+{
+	struct bbr *bbr = inet_csk_ca(sk);
+	u32 thresh;
+
+	thresh = bbr_lfn_thresh_tenths(sk);
+	if (!thresh || !bbr->lfn_round_valid || bbr->lfn_round_over ||
+	    bbr->lfn_round_congested)
+		return false;
+	if (bbr->mode != BBR_PROBE_BW)
+		return false;
+	if ((u32)bbr->lfn_round * 5 > thresh)
+		return false;
+	return bbr_lfn_min_rtt_fresh(sk) && bbr_lfn_rtt_flat(sk, rs);
+}
+
+/* Fold this ACK into the current loss-round. Zeros are included so the
+ * floor can fall. App-limited samples are ignored. Small flights do not
+ * move the average, but a small flight above the hard cap still poisons
+ * the round (fail closed).
+ */
+static void bbr_lfn_note_sample(struct sock *sk, const struct rate_sample *rs)
+{
+	struct bbr *bbr = inet_csk_ca(sk);
+	u32 tenths = 0, sample, weight, i;
+
+	if (bbr_lfn_pct(sk) <= 0)
+		return;
+	if (rs->is_app_limited)
+		goto mark_probe;
+
+	if (rs->tx_in_flight) {
+		tenths = ((u64)rs->lost * 1000) / rs->tx_in_flight;
+		/* A tiny flight at 1/4 lost is not evidence of an 8% floor.
+		 * Only a real sample above the cap fails the round closed.
+		 */
+		if (rs->tx_in_flight >= BBR_LFN_POISON_TX &&
+		    tenths > BBR_LFN_CAP_TENTHS)
+			bbr->lfn_round_over = 1;
+		if (rs->rtt_us > 0 &&
+		    bbr->min_rtt_us >= BBR_LFN_MIN_PATH_RTT_US &&
+		    bbr->min_rtt_us != ~0U &&
+		    (u64)rs->rtt_us * 5 >= (u64)bbr->min_rtt_us * 6)
+			bbr->lfn_round_congested = 1;
+	}
+	if (rs->tx_in_flight < BBR_LFN_MIN_TX)
+		goto mark_probe;
+
+	sample = min_t(u32, tenths / 5, 31);
+	weight = min_t(u32, rs->tx_in_flight / BBR_LFN_MIN_TX, 8);
+	if (!bbr->lfn_round_valid) {
+		bbr->lfn_round = sample;
+		bbr->lfn_round_valid = 1;
+		weight--;
+	}
+	for (i = 0; i < weight; i++)
+		bbr->lfn_round = (bbr->lfn_round * 3 + sample) / 4;
+
+mark_probe:
+	if (bbr->bw_probe_samples ||
+	    (bbr->mode == BBR_PROBE_BW &&
+	     (bbr->cycle_idx == BBR_BW_PROBE_UP ||
+	      bbr->cycle_idx == BBR_BW_PROBE_REFILL)))
+		bbr->lfn_round_probe = 1;
+}
+
+static void bbr_lfn_round_reset(struct bbr *bbr)
+{
+	bbr->lfn_round = 0;
+	bbr->lfn_round_valid = 0;
+	bbr->lfn_round_probe = 0;
+	bbr->lfn_round_congested = 0;
+	bbr->lfn_round_over = 0;
+}
+
+/* Once per loss-round, after the backoff decision: move the floor toward
+ * this round's uncongested loss rate. Cruise only, so STARTUP and probes
+ * cannot teach a high floor. Samples above the cap are not learned.
+ */
+static void bbr_lfn_round_finish(struct sock *sk)
+{
+	struct bbr *bbr = inet_csk_ca(sk);
+	u32 sample, floor;
+
+	if (!bbr->loss_round_start)
+		return;
+	if (bbr_lfn_pct(sk) == 1 &&
+	    bbr->lfn_round_valid &&
+	    !bbr->lfn_round_probe &&
+	    !bbr->lfn_round_congested &&
+	    !bbr->lfn_round_over &&
+	    bbr->mode == BBR_PROBE_BW &&
+	    bbr->cycle_idx == BBR_BW_PROBE_CRUISE &&
+	    bbr->min_rtt_us >= BBR_LFN_MIN_PATH_RTT_US &&
+	    bbr_lfn_min_rtt_fresh(sk)) {
+		sample = min_t(u32, (u32)bbr->lfn_round * 5, BBR_LFN_CAP_TENTHS);
+		floor = bbr->lfn_floor;
+		bbr->lfn_floor = (floor * 3 + sample) / 4;
+	}
+	bbr_lfn_round_reset(bbr);
+}
+
 /* Does loss/ECN rate for this sample say inflight is "too high"?
  * This is used by both the bbr_check_loss_too_high_in_startup() function,
  * which can be used in either v1 or v2, and the PROBE_UP phase of v2, which
  * uses it to notice when loss/ECN rates suggest inflight is too high.
  */
-static bool bbr_is_inflight_too_high(const struct sock *sk,
+static bool bbr_is_inflight_too_high(struct sock *sk,
 				      const struct rate_sample *rs)
 {
 	const struct bbr *bbr = inet_csk_ca(sk);
@@ -1178,7 +1453,8 @@
 	if (rs->lost > 0 && rs->tx_in_flight) {
 		loss_thresh = (u64)rs->tx_in_flight * bbr_param(sk, loss_thresh) >>
 				BBR_SCALE;
-		if (rs->lost > loss_thresh) {
+		if (rs->lost > loss_thresh &&
+		    !bbr_lfn_loss_tolerated(sk, rs)) {
 			return true;
 		}
 	}
@@ -1387,8 +1663,11 @@
 		bbr_ecn_lower_bounds(sk, &ecn_inflight_lo);
 	}
 
-	/* Loss response. */
-	if (bbr->loss_in_round) {
+	/* Loss response. LFN, when enabled, skips the cut only for a whole
+	 * round whose loss rate is within tolerance. Do not init the bounds
+	 * in that case: init would install inflight_lo == cwnd and pin it.
+	 */
+	if (bbr->loss_in_round && !bbr_lfn_round_exempt(sk, rs)) {
 		bbr_init_lower_bounds(sk, true);
 		bbr_loss_lower_bounds(sk, &bbr->bw_lo, &bbr->inflight_lo);
 	}
@@ -2053,6 +2332,7 @@
 	bbr->ecn_in_round  |= (bbr->ecn_eligible && rs->is_ece);
 	bbr_calculate_bw_sample(sk, rs, &ctx);
 	bbr_update_latest_delivery_signals(sk, rs, &ctx);
+	bbr_lfn_note_sample(sk, rs);
 
 	if (bbr_run_fast_path(sk, &update_model, rs, &ctx))
 		goto out;
@@ -2068,6 +2348,7 @@
 	bbr_bound_cwnd_for_inflight_model(sk);
 
 out:
+	bbr_lfn_round_finish(sk);
 	bbr_advance_latest_delivery_signals(sk, rs, &ctx);
 	bbr->prev_ca_state = inet_csk(sk)->icsk_ca_state;
 	bbr->loss_in_cycle |= rs->lost > 0;
@@ -2080,6 +2361,8 @@
 	struct bbr *bbr = inet_csk_ca(sk);
 
 	bbr->initialized = 1;
+	bbr->lfn_floor = 0;
+	bbr_lfn_round_reset(bbr);
 
 	bbr->init_cwnd = min(0x7FU, tcp_snd_cwnd(tp));
 	bbr->prior_cwnd = tp->prior_cwnd;
@@ -2372,21 +2655,112 @@
 	.set   = &tcp_bbr_check_kfunc_ids,
 };
 
+static int bbr_lfn_loss_thresh_pct = 1;
+static int bbr_lfn_min_rtt_fresh_ms = 15000;
+module_param_named(lfn_loss_thresh_pct, bbr_lfn_loss_thresh_pct, int, 0644);
+MODULE_PARM_DESC(lfn_loss_thresh_pct,
+		 "LFN loss tolerance: 0 off, 1 auto (default), 2-8 manual percent");
+module_param_named(lfn_min_rtt_fresh_ms, bbr_lfn_min_rtt_fresh_ms, int, 0644);
+MODULE_PARM_DESC(lfn_min_rtt_fresh_ms,
+		 "max age (ms) of BBR min_rtt for LFN tolerance; 0 disables the check");
+
+#ifdef CONFIG_SYSCTL
+static struct ctl_table bbr_sysctl_template[] = {
+	{
+		.procname	= "tcp_bbr_lfn_loss_thresh_pct",
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= (void *)&bbr_lfn_pct_max,
+	},
+	{
+		.procname	= "tcp_bbr_lfn_min_rtt_fresh_ms",
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= (void *)&bbr_lfn_fresh_max,
+	},
+	{ }
+};
+#endif
+
+static int __net_init bbr_net_init(struct net *net)
+{
+	struct bbr_net *bn = net_generic(net, bbr_net_id);
+
+	bn->loss_thresh_pct = READ_ONCE(bbr_lfn_loss_thresh_pct);
+	bn->min_rtt_fresh_ms = READ_ONCE(bbr_lfn_min_rtt_fresh_ms);
+#ifdef CONFIG_SYSCTL
+	bn->table = kmemdup(bbr_sysctl_template, sizeof(bbr_sysctl_template),
+			    GFP_KERNEL);
+	if (!bn->table)
+		return -ENOMEM;
+	bn->table[0].data = &bn->loss_thresh_pct;
+	bn->table[1].data = &bn->min_rtt_fresh_ms;
+	bn->hdr = register_net_sysctl_sz(net, "net/ipv4", bn->table,
+					 ARRAY_SIZE(bbr_sysctl_template));
+	if (!bn->hdr) {
+		kfree(bn->table);
+		bn->table = NULL;
+		return -ENOMEM;
+	}
+#endif
+	return 0;
+}
+
+static void __net_exit bbr_net_exit(struct net *net)
+{
+	struct bbr_net *bn = net_generic(net, bbr_net_id);
+
+#ifdef CONFIG_SYSCTL
+	if (bn->hdr)
+		unregister_net_sysctl_table(bn->hdr);
+	kfree(bn->table);
+#endif
+}
+
+static struct pernet_operations bbr_net_ops = {
+	.init = bbr_net_init,
+	.exit = bbr_net_exit,
+	.id   = &bbr_net_id,
+	.size = sizeof(struct bbr_net),
+};
+
 static int __init bbr_register(void)
 {
 	int ret;
 
 	BUILD_BUG_ON(sizeof(struct bbr) > ICSK_CA_PRIV_SIZE);
+	if (bbr_lfn_loss_thresh_pct < 0 ||
+	    bbr_lfn_loss_thresh_pct > bbr_lfn_pct_max)
+		return -EINVAL;
+	if (bbr_lfn_min_rtt_fresh_ms < 0 ||
+	    bbr_lfn_min_rtt_fresh_ms > bbr_lfn_fresh_max)
+		return -EINVAL;
 
-	ret = register_btf_kfunc_id_set(BPF_PROG_TYPE_STRUCT_OPS, &tcp_bbr_kfunc_set);
-	if (ret < 0)
+	ret = register_pernet_subsys(&bbr_net_ops);
+	if (ret)
 		return ret;
-	return tcp_register_congestion_control(&tcp_bbr_cong_ops);
+	ret = register_btf_kfunc_id_set(BPF_PROG_TYPE_STRUCT_OPS,
+				       &tcp_bbr_kfunc_set);
+	if (ret < 0)
+		goto err_pernet;
+	ret = tcp_register_congestion_control(&tcp_bbr_cong_ops);
+	if (ret)
+		goto err_pernet;
+	return 0;
+
+err_pernet:
+	unregister_pernet_subsys(&bbr_net_ops);
+	return ret;
 }
 
 static void __exit bbr_unregister(void)
 {
 	tcp_unregister_congestion_control(&tcp_bbr_cong_ops);
+	unregister_pernet_subsys(&bbr_net_ops);
 }
 
 module_init(bbr_register);
