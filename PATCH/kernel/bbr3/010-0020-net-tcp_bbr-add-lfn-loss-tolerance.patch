From 7c1e5a88294a2176b6d859187ec51f5010b91cb2 Mon Sep 17 00:00:00 2001
From: QiuSimons <45143996+QiuSimons@users.noreply.github.com>
Date: Fri, 23 Oct 2026 12:30:00 +0800
Subject: [PATCH 20/20] net-tcp_bbr: add adaptive LFN loss tolerance via pernet
 sysctl

Paths with high bandwidth-delay products (satellite, wireless, WAN)
frequently see random, non-congestive loss (e.g. 2-5%). BBRv3 keeps a
fixed 2% loss threshold, so above it it cuts inflight_hi while probing and
cuts the lower bounds once per loss round, which costs a lot of throughput
on long-fat paths.

Add an adaptive LFN loss tolerance mechanism to tcp_bbr:

- Learn the uncongested loss floor from rate samples that look
  uncongested: srtt < 1.2 * min_rtt, min_rtt fresh, inflight within 1.15x
  BDP, no bandwidth probing, PROBE_BW only. The floor is folded in once
  per loss round, in CRUISE only, and only after the backoff decision of
  that round.
- The per-sample loss rate is BBRv3's rs->lost / rs->tx_in_flight, which
  covers a full flight window (rs->lost is tp->lost at the skb's transmit
  time). Both filters are integer EWMAs stepped once per sample with ceil
  division; plain "/ 4" leaves steps of 3 units or less at a fixed point
  and under-learns the loss rate. The floor is a mean filter: a per-round
  peak would follow the noisiest sample and over-learn.
- Tolerate min(floor + 1.0%, 8.0%), and keep the stock 2% on clean paths.
  While probing, cap the tolerated rate at floor + 1.0% and tolerate
  nothing beyond the stock response without a learned floor, so drops that
  only appear when inflight is pushed above BDP still bound inflight_hi.
- Restrict tolerance to loss rounds whose samples were all uncongested. A
  queued RTT, an over-cap (> 8%) sample on a real flight, or a probe
  poisons the round. Tolerance is also dropped when min_rtt is stale, on
  short paths (< 10ms), and for flights above 1.15x BDP outside STARTUP.
  STARTUP keeps the stock threshold; a manual ceiling also applies there.
- Fold each sample into the loss round before the per-round decision, so
  the ACK that starts a new round is counted in the round it closes, as
  bbr_update_congestion_signals() does.
- Over-threshold losses still cut inflight_hi normally; exempt rounds skip
  the lower-bound cut without pinning inflight_lo. The ECN response is
  unchanged.
- Implemented per-netns via a tcp_bbr sysctl without modifying global tcp
  structs or sysctl tables:
    net.ipv4.tcp_bbr_lfn_loss_thresh_pct (0=off, 1=auto, 2-8=manual)
    net.ipv4.tcp_bbr_lfn_min_rtt_fresh_ms (default 15000)
  The module parameters of the same name are only defaults for network
  namespaces created later; write the sysctl to change a running namespace
  (including init_net).

Default is 1 (auto): clean paths keep the stock 2% threshold.

Signed-off-by: QiuSimons <45143996+QiuSimons@users.noreply.github.com>
---
 net/ipv4/tcp_bbr.c | 426 +++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 416 insertions(+), 10 deletions(-)

--- a/net/ipv4/tcp_bbr.c
+++ b/net/ipv4/tcp_bbr.c
@@ -60,6 +60,10 @@
 #include <linux/btf.h>
 #include <linux/btf_ids.h>
 #include <linux/module.h>
+#include <linux/slab.h>
+#include <linux/sysctl.h>
+#include <net/net_namespace.h>
+#include <net/netns/generic.h>
 #include <net/tcp.h>
 #include <linux/inet_diag.h>
 #include <linux/inet.h>
@@ -85,6 +89,18 @@
 #define BBR_SCALE 8	/* scaling factor for fractions in BBR (e.g. gains) */
 #define BBR_UNIT (1 << BBR_SCALE)
 
+/* LFN loss tolerance for non-congestive loss on long-fat paths.
+ * 0 disables. See bbr_lfn_* below. Values are tenths of a percent.
+ */
+#define BBR_LFN_MIN_PATH_RTT_US	10000	/* ignore DC / short paths */
+#define BBR_LFN_MIN_TX		16	/* min packets in a ratio sample */
+#define BBR_LFN_POISON_TX	64	/* smaller flights must not veto a round */
+#define BBR_LFN_CAP_TENTHS	80	/* hard cap: 8.0% */
+#define BBR_LFN_STOCK_TENTHS	20	/* BBRv3 loss_thresh: 2.0% */
+#define BBR_LFN_MARGIN_TENTHS	10	/* auto: floor + 1.0% */
+#define BBR_LFN_AVG_MAX		63	/* 0.2% units: max 12.6% */
+#define BBR_LFN_EWMA_GAIN	4	/* EWMA time constant, samples/rounds */
+
 /* BBR has the following modes for deciding how fast to send: */
 enum bbr_mode {
 	BBR_STARTUP,	/* ramp up sending rate rapidly to fill pipe */
@@ -120,14 +136,16 @@ struct bbr {
 		idle_restart:1,	     /* restarting after idle? */
 		probe_rtt_round_done:1,  /* a BBR_PROBE_RTT round at 4 pkts? */
 		init_cwnd:7,         /* initial cwnd */
-		unused_1:10;
+		lfn_floor:8,	/* uncongested loss floor, 0.1% units */
+		lfn_round_poison:1, /* round saw probe or >cap loss */
+		lfn_round_congested:1; /* round saw RTT >= 1.2*min */
 	u32	pacing_gain:10,	/* current gain for setting pacing rate */
 		cwnd_gain:10,	/* current gain for setting cwnd */
 		full_bw_reached:1,   /* reached full bw in Startup? */
 		full_bw_cnt:2,	/* number of rounds without large bw gains */
 		cycle_idx:2,	/* current index in pacing_gain cycle array */
 		has_seen_rtt:1, /* have we seen an RTT sample yet? */
-		unused_2:6;
+		lfn_avg:6;	/* EWMA of uncongested sample loss, 0.2% units */
 	u32	prior_cwnd;	/* prior cwnd upon entering loss recovery */
 	u32	full_bw;	/* recent bw, to estimate if pipe is full */
 
@@ -142,7 +160,7 @@ struct bbr {
 		startup_ecn_rounds:2,	/* consecutive hi ECN STARTUP rounds */
 		loss_in_cycle:1,	/* packet loss in this cycle? */
 		ecn_in_cycle:1,		/* ECN in this cycle? */
-		unused_3:1;
+		lfn_round_sampled:1;	/* round got an uncongested sample */
 	u32	loss_round_delivered; /* scb->tx.delivered ending loss round */
 	u32	undo_bw_lo;	     /* bw_lo before latest losses */
 	u32	undo_inflight_lo;    /* inflight_lo before latest losses */
@@ -1164,12 +1182,300 @@ static void bbr_probe_inflight_hi_upward
 		bbr_raise_inflight_hi_slope(sk);
 }
 
+/* ----- LFN loss tolerance -------------------------------------------
+ *
+ * Physical loss on a long-fat path (satellite, some cross-border WANs) is
+ * not a congestion signal, but BBRv3 still treats loss above 2% as
+ * "inflight too high" (cutting inflight_hi while probing, leaving STARTUP
+ * early) and cuts bw_lo/inflight_lo on any loss in a non-probing round.
+ *
+ * This is off when net.ipv4.tcp_bbr_lfn_loss_thresh_pct is 0. It defaults
+ * to 1 (auto): tolerate min(floor + 1.0%, 8.0%), where the floor is an
+ * EWMA of the loss rate of samples that look uncongested (srtt < 1.2 *
+ * min_rtt, min_rtt fresh, inflight within 1.15x BDP, no bandwidth probe),
+ * folded in at the end of a CRUISE loss round. Clean paths stay at the
+ * stock 2%.
+ *
+ * While probing, the tolerated rate is capped at floor + 1.0%, so drops
+ * that only appear when inflight is pushed above BDP still cut
+ * inflight_hi. Loss above the tolerated rate takes the stock backoff, and
+ * the ECN response is unchanged.
+ *
+ * pct sysctl: 0 off, 1 auto (threshold = floor + 1%), 2..8 manual ceiling
+ *             in percent. The floor is learned in both modes.
+ */
+
+struct bbr_net {
+	struct ctl_table_header *hdr;
+#ifdef CONFIG_SYSCTL
+	struct ctl_table *table;
+#endif
+	int loss_thresh_pct;
+	int min_rtt_fresh_ms;
+};
+
+static unsigned int bbr_net_id;
+static const int bbr_lfn_pct_max = 8;
+static const int bbr_lfn_fresh_max = 60000;
+
+static struct bbr_net *bbr_net(const struct sock *sk)
+{
+	return net_generic(sock_net(sk), bbr_net_id);
+}
+
+static int bbr_lfn_pct(const struct sock *sk)
+{
+	return READ_ONCE(bbr_net(sk)->loss_thresh_pct);
+}
+
+static u32 bbr_lfn_fresh_ms(const struct sock *sk)
+{
+	return READ_ONCE(bbr_net(sk)->min_rtt_fresh_ms);
+}
+
+/* Threshold in 0.1% units. 0 means the feature is off. */
+static u32 bbr_lfn_thresh_tenths(const struct sock *sk)
+{
+	const struct bbr *bbr = inet_csk_ca(sk);
+	int pct = bbr_lfn_pct(sk);
+	u32 floor, thresh;
+
+	if (pct <= 0)
+		return 0;
+	if (pct > 1)
+		return (u32)min_t(int, pct, bbr_lfn_pct_max) * 10;
+
+	/* Auto. Stay at the stock 2% until the learned floor exceeds it. */
+	floor = bbr->lfn_floor;
+	thresh = floor + BBR_LFN_MARGIN_TENTHS;
+	if (thresh <= BBR_LFN_STOCK_TENTHS)
+		return BBR_LFN_STOCK_TENTHS;
+	return min_t(u32, thresh, BBR_LFN_CAP_TENTHS);
+}
+
+/* tcp_jiffies32 is a u32 jiffies counter, so this delta is wrap-safe. */
+static bool bbr_lfn_min_rtt_fresh(const struct sock *sk)
+{
+	const struct bbr *bbr = inet_csk_ca(sk);
+	u32 limit_ms = bbr_lfn_fresh_ms(sk);
+
+	if (!limit_ms)
+		return true;
+	if (!bbr->min_rtt_stamp)
+		return false;
+	return jiffies_to_msecs(tcp_jiffies32 - bbr->min_rtt_stamp) <= limit_ms;
+}
+
+/* Is the path free of a persistent queue? Use srtt: a per-ACK RTT sample
+ * is too noisy on the wireless and satellite links this targets.
+ */
+static bool bbr_lfn_rtt_flat(const struct sock *sk)
+{
+	const struct bbr *bbr = inet_csk_ca(sk);
+	u32 srtt_us = tcp_sk(sk)->srtt_us >> 3;
+
+	if (bbr->min_rtt_us == ~0U || bbr->min_rtt_us < BBR_LFN_MIN_PATH_RTT_US)
+		return false;
+	if (!srtt_us)
+		return false;
+	return (u64)srtt_us * 5 < (u64)bbr->min_rtt_us * 6;
+}
+
+/* True while the loss samples still reflect our own bandwidth probing. The
+ * probe feedback outlives the PROBE_UP phase itself, hence bw_probe_samples.
+ */
+static bool bbr_lfn_bw_probing(const struct bbr *bbr)
+{
+	return bbr->bw_probe_samples ||
+	       (bbr->mode == BBR_PROBE_BW &&
+		(bbr->cycle_idx == BBR_BW_PROBE_UP ||
+		 bbr->cycle_idx == BBR_BW_PROBE_REFILL));
+}
+
+/* Loss rate of one rate sample in 0.1% units, clamped to 100%. BBRv3 counts
+ * rs->lost over the flight window that rs->tx_in_flight snapshots, so this
+ * ratio already covers roughly one RTT rather than one ACK.
+ */
+static u32 bbr_lfn_sample_tenths(const struct rate_sample *rs)
+{
+	if (rs->lost <= 0 || !rs->tx_in_flight)
+		return 0;
+	return (u32)min_t(u64, div_u64((u64)rs->lost * 1000, rs->tx_in_flight),
+			  1000U);
+}
+
+/* One EWMA step of @cur toward @sample, clamped to @max. Uses ceil division
+ * so any non-zero distance moves the filter: with plain "/ 4" a sample
+ * within 3 units of the current value is a fixed point.
+ */
+static u32 bbr_lfn_ewma_step(u32 cur, u32 sample, u32 max)
+{
+	if (sample > cur)
+		return min_t(u32, cur + DIV_ROUND_UP(sample - cur,
+						     BBR_LFN_EWMA_GAIN), max);
+	if (sample < cur)
+		return cur - DIV_ROUND_UP(cur - sample, BBR_LFN_EWMA_GAIN);
+	return cur;
+}
+
+/* True when this loss sample should not count as inflight-too-high.
+ * Read-only: the floor is not updated here.
+ */
+static bool bbr_lfn_loss_tolerated(struct sock *sk, const struct rate_sample *rs)
+{
+	struct bbr *bbr = inet_csk_ca(sk);
+	u32 thresh, tenths, pipe, roof;
+
+	thresh = bbr_lfn_thresh_tenths(sk);
+	if (!thresh)
+		return false;
+	/* Probing is exempted only up to the loss rate already measured as
+	 * uncongested: probe-induced drops must still cut inflight_hi.
+	 */
+	if (bbr_lfn_bw_probing(bbr))
+		thresh = min_t(u32, thresh,
+			       bbr->lfn_floor + BBR_LFN_MARGIN_TENTHS);
+	/* Any queued RTT or over-cap sample this round: stock response. */
+	if (bbr->lfn_round_poison || bbr->lfn_round_congested)
+		return false;
+	if (!bbr_lfn_min_rtt_fresh(sk) || !bbr_lfn_rtt_flat(sk))
+		return false;
+	if (!rs->tx_in_flight || rs->tx_in_flight < BBR_LFN_MIN_TX)
+		return false;
+
+	tenths = bbr_lfn_sample_tenths(rs);
+	if (tenths > thresh)
+		return false;
+	/* The recent uncongested loss rate is already above what we tolerate. */
+	if ((u32)bbr->lfn_avg * 2 > thresh)
+		return false;
+
+	/* STARTUP sends above BDP on purpose; elsewhere a flight well above
+	 * the pipe is our own queueing, not path loss.
+	 */
+	if (bbr->mode != BBR_STARTUP) {
+		pipe = bbr_inflight(sk, bbr_max_bw(sk), BBR_UNIT);
+		roof = div_u64((u64)pipe * 115, 100);
+		if (rs->tx_in_flight > roof)
+			return false;
+	}
+	return true;
+}
+
+/* The recent uncongested loss rate is within tolerance. Used for the
+ * once-per-round bw_lo cut, which upstream applies on any loss, not at the
+ * 2% inflight threshold. Does not look at one ACK's rs->lost (that ACK is
+ * often not the lossy one).
+ */
+static bool bbr_lfn_round_exempt(struct sock *sk, const struct rate_sample *rs)
+{
+	struct bbr *bbr = inet_csk_ca(sk);
+	u32 thresh;
+
+	thresh = bbr_lfn_thresh_tenths(sk);
+	if (!thresh || !bbr->lfn_round_sampled || bbr->lfn_round_poison ||
+	    bbr->lfn_round_congested)
+		return false;
+	if (bbr->mode != BBR_PROBE_BW)
+		return false;
+	if ((u32)bbr->lfn_avg * 2 > thresh)
+		return false;
+	return bbr_lfn_min_rtt_fresh(sk) && bbr_lfn_rtt_flat(sk);
+}
+
+/* Fold one rate sample into the uncongested-loss EWMA. Samples that look
+ * congested, probing, tiny, or above the hard cap are not fed; a probe, an
+ * over-cap sample on a real flight, or a queued RTT poisons the loss round.
+ * Runs before the per-round decision, so the ACK that starts a new round is
+ * counted in the round it closes; the floor is updated after the decision.
+ */
+static void bbr_lfn_note_sample(struct sock *sk, const struct rate_sample *rs)
+{
+	struct bbr *bbr = inet_csk_ca(sk);
+	u32 tenths, pipe, roof;
+
+	if (bbr_lfn_pct(sk) <= 0)
+		return;
+	if (!rs->tx_in_flight)
+		return;
+
+	/* Poison the round on signals the floor must not learn from. */
+	if (bbr_lfn_bw_probing(bbr))
+		bbr->lfn_round_poison = 1;
+	tenths = bbr_lfn_sample_tenths(rs);
+	/* Above the hard cap: not an uncongested-loss sample, whatever the
+	 * flight size. Only a real flight also poisons the round; a tiny
+	 * flight at high loss is not evidence of an 8% floor.
+	 */
+	if (tenths > BBR_LFN_CAP_TENTHS) {
+		if (rs->tx_in_flight >= BBR_LFN_POISON_TX)
+			bbr->lfn_round_poison = 1;
+		return;
+	}
+	if (!bbr_lfn_rtt_flat(sk)) {
+		bbr->lfn_round_congested = 1;
+		return;
+	}
+
+	/* Only a valid, steady-state PROBE_BW sample can teach the floor:
+	 * inflight in STARTUP and DRAIN is above BDP by design, and
+	 * PROBE_RTT sends 4 packets.
+	 */
+	if (rs->interval_us <= 0 || !rs->acked_sacked || rs->is_app_limited)
+		return;
+	if (bbr->mode != BBR_PROBE_BW)
+		return;
+	if (!bbr_lfn_min_rtt_fresh(sk) || rs->tx_in_flight < BBR_LFN_MIN_TX)
+		return;
+	pipe = bbr_inflight(sk, bbr_max_bw(sk), BBR_UNIT);
+	roof = div_u64((u64)pipe * 115, 100);
+	if (rs->tx_in_flight > roof)
+		return;
+
+	/* Quantize up to 0.2% units so a small non-zero rate is not lost. */
+	bbr->lfn_avg = bbr_lfn_ewma_step(bbr->lfn_avg, (tenths + 1) / 2,
+					 BBR_LFN_AVG_MAX);
+	bbr->lfn_round_sampled = 1;
+}
+
+static void bbr_lfn_round_reset(struct bbr *bbr)
+{
+	bbr->lfn_round_sampled = 0;
+	bbr->lfn_round_poison = 0;
+	bbr->lfn_round_congested = 0;
+}
+
+/* Once per loss round, after the backoff decision: move the floor toward
+ * the recent uncongested loss rate. Cruise only, so STARTUP and probes
+ * cannot teach a high floor. 2 * lfn_avg converts 0.2% to 0.1% units.
+ */
+static void bbr_lfn_round_finish(struct sock *sk)
+{
+	struct bbr *bbr = inet_csk_ca(sk);
+
+	if (!bbr->loss_round_start)
+		return;
+	if (bbr_lfn_pct(sk) > 0 &&
+	    bbr->lfn_round_sampled &&
+	    !bbr->lfn_round_poison &&
+	    !bbr->lfn_round_congested &&
+	    bbr->mode == BBR_PROBE_BW &&
+	    bbr->cycle_idx == BBR_BW_PROBE_CRUISE &&
+	    bbr->min_rtt_us != ~0U &&
+	    bbr->min_rtt_us >= BBR_LFN_MIN_PATH_RTT_US &&
+	    bbr_lfn_min_rtt_fresh(sk))
+		bbr->lfn_floor = bbr_lfn_ewma_step(bbr->lfn_floor,
+						   (u32)bbr->lfn_avg * 2,
+						   BBR_LFN_CAP_TENTHS);
+	bbr_lfn_round_reset(bbr);
+}
+
 /* Does loss/ECN rate for this sample say inflight is "too high"?
  * This is used by both the bbr_check_loss_too_high_in_startup() function,
  * which can be used in either v1 or v2, and the PROBE_UP phase of v2, which
  * uses it to notice when loss/ECN rates suggest inflight is too high.
  */
-static bool bbr_is_inflight_too_high(const struct sock *sk,
+static bool bbr_is_inflight_too_high(struct sock *sk,
 				      const struct rate_sample *rs)
 {
 	const struct bbr *bbr = inet_csk_ca(sk);
@@ -1178,7 +1484,8 @@ static bool bbr_is_inflight_too_high(con
 	if (rs->lost > 0 && rs->tx_in_flight) {
 		loss_thresh = (u64)rs->tx_in_flight * bbr_param(sk, loss_thresh) >>
 				BBR_SCALE;
-		if (rs->lost > loss_thresh) {
+		if (rs->lost > loss_thresh &&
+		    !bbr_lfn_loss_tolerated(sk, rs)) {
 			return true;
 		}
 	}
@@ -1387,8 +1694,11 @@ static void bbr_adapt_lower_bounds(struc
 		bbr_ecn_lower_bounds(sk, &ecn_inflight_lo);
 	}
 
-	/* Loss response. */
-	if (bbr->loss_in_round) {
+	/* Loss response. LFN, when enabled, skips the cut only for a whole
+	 * round whose loss rate is within tolerance. Do not init the bounds
+	 * in that case: init would install inflight_lo == cwnd and pin it.
+	 */
+	if (bbr->loss_in_round && !bbr_lfn_round_exempt(sk, rs)) {
 		bbr_init_lower_bounds(sk, true);
 		bbr_loss_lower_bounds(sk, &bbr->bw_lo, &bbr->inflight_lo);
 	}
@@ -2053,6 +2363,7 @@ __bpf_kfunc static void bbr_main(struct
 	bbr->ecn_in_round  |= (bbr->ecn_eligible && rs->is_ece);
 	bbr_calculate_bw_sample(sk, rs, &ctx);
 	bbr_update_latest_delivery_signals(sk, rs, &ctx);
+	bbr_lfn_note_sample(sk, rs);
 
 	if (bbr_run_fast_path(sk, &update_model, rs, &ctx))
 		goto out;
@@ -2068,6 +2379,7 @@ __bpf_kfunc static void bbr_main(struct
 	bbr_bound_cwnd_for_inflight_model(sk);
 
 out:
+	bbr_lfn_round_finish(sk);
 	bbr_advance_latest_delivery_signals(sk, rs, &ctx);
 	bbr->prev_ca_state = inet_csk(sk)->icsk_ca_state;
 	bbr->loss_in_cycle |= rs->lost > 0;
@@ -2080,6 +2392,9 @@ __bpf_kfunc static void bbr_init(struct
 	struct bbr *bbr = inet_csk_ca(sk);
 
 	bbr->initialized = 1;
+	bbr->lfn_floor = 0;
+	bbr->lfn_avg = 0;
+	bbr_lfn_round_reset(bbr);
 
 	bbr->init_cwnd = min(0x7FU, tcp_snd_cwnd(tp));
 	bbr->prior_cwnd = tp->prior_cwnd;
@@ -2372,21 +2687,112 @@ static const struct btf_kfunc_id_set tcp
 	.set   = &tcp_bbr_check_kfunc_ids,
 };
 
+static int bbr_lfn_loss_thresh_pct = 1;
+static int bbr_lfn_min_rtt_fresh_ms = 15000;
+module_param_named(lfn_loss_thresh_pct, bbr_lfn_loss_thresh_pct, int, 0644);
+MODULE_PARM_DESC(lfn_loss_thresh_pct,
+		 "LFN loss tolerance: 0 off, 1 auto (default), 2-8 manual percent");
+module_param_named(lfn_min_rtt_fresh_ms, bbr_lfn_min_rtt_fresh_ms, int, 0644);
+MODULE_PARM_DESC(lfn_min_rtt_fresh_ms,
+		 "max age (ms) of BBR min_rtt for LFN tolerance; 0 disables the check");
+
+#ifdef CONFIG_SYSCTL
+static struct ctl_table bbr_sysctl_template[] = {
+	{
+		.procname	= "tcp_bbr_lfn_loss_thresh_pct",
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= (void *)&bbr_lfn_pct_max,
+	},
+	{
+		.procname	= "tcp_bbr_lfn_min_rtt_fresh_ms",
+		.maxlen		= sizeof(int),
+		.mode		= 0644,
+		.proc_handler	= proc_dointvec_minmax,
+		.extra1		= SYSCTL_ZERO,
+		.extra2		= (void *)&bbr_lfn_fresh_max,
+	},
+	{ }
+};
+#endif
+
+static int __net_init bbr_net_init(struct net *net)
+{
+	struct bbr_net *bn = net_generic(net, bbr_net_id);
+
+	bn->loss_thresh_pct = READ_ONCE(bbr_lfn_loss_thresh_pct);
