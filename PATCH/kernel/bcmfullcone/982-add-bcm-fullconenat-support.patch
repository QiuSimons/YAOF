+/****************************************************************************/
+/****************************************************************************/
+/****************************************************************************/
+/* Install the full-cone expectation.  Shared by v4 and v6. */
+static struct nf_conntrack_expect *bcm_nat_expect_create(struct nf_conn *ct,
+                                                       u8 l3num, int dir)
+{
+       struct nf_conn_help *help = nfct_help(ct);
+       struct nf_conntrack_expect *exp;
+
+       if (help && help->expecting[NF_CT_EXPECT_CLASS_DEFAULT])
+               return NULL;
+
+       exp = nf_ct_expect_alloc(ct);
+       if (exp == NULL)
+               return NULL;
+
+       nf_ct_expect_init(exp, NF_CT_EXPECT_CLASS_DEFAULT, l3num, NULL,
+                         &ct->tuplehash[!dir].tuple.dst.u3, IPPROTO_UDP,
+                         NULL, &ct->tuplehash[!dir].tuple.dst.u.udp.port);
+       exp->flags = NF_CT_EXPECT_PERMANENT;
+       exp->saved_addr = ct->tuplehash[dir].tuple.src.u3;
+       exp->saved_proto.udp.port = ct->tuplehash[dir].tuple.src.u.udp.port;
+       exp->dir = !dir;
+       exp->expectfn = bcm_nat_expect;
+
+       if (nf_ct_expect_related(exp, 0) != 0) {
+               nf_ct_expect_put(exp);
+               return NULL;
+       }
+
+       return exp;
+}
+
+/* Create the expectation on the first original-direction packet. */
+static int bcm_nat_help(struct sk_buff *skb, unsigned int protoff,
+                       struct nf_conn *ct, enum ip_conntrack_info ctinfo)
+{
+       int dir = CTINFO2DIR(ctinfo);
+       struct nf_conntrack_expect *exp;
+
+       if (dir != IP_CT_DIR_ORIGINAL)
+               return NF_ACCEPT;
+
+       exp = bcm_nat_expect_create(ct, ct->tuplehash[dir].tuple.src.l3num, dir);
+       if (exp != NULL) {
+               pr_debug("bcm_nat: expect set up\n");
+               nf_ct_expect_put(exp);
+       }
+
+       return NF_ACCEPT;
+}
+
+/****************************************************************************/
+static struct nf_conntrack_expect_policy bcm_nat_exp_policy __read_mostly = {
+       .max_expected   = 1000,
+       .timeout        = 240,
+};
+
+/****************************************************************************/
+static struct nf_conntrack_helper nf_conntrack_helper_bcm_nat __read_mostly = {
+       .name = "BCM-NAT",
+       .me = THIS_MODULE,
+       .tuple.src.l3num = AF_INET,
+       .tuple.dst.protonum = IPPROTO_UDP,
+       .expect_policy = &bcm_nat_exp_policy,
+       .expect_class_max = 1,
+       .help = bcm_nat_help,
+};
+
+#if IS_ENABLED(CONFIG_IPV6)
+static struct nf_conntrack_helper nf_conntrack_helper_bcm_nat6 __read_mostly = {
+       .name = "BCM-NAT6",
+       .me = THIS_MODULE,
+       .tuple.src.l3num = AF_INET6,
+       .tuple.dst.protonum = IPPROTO_UDP,
+       .expect_policy = &bcm_nat_exp_policy,
+       .expect_class_max = 1,
+       .help = bcm_nat_help,
+};
+#endif
+
+/****************************************************************************/
+static inline int find_exp(__be32 ip, __be16 port, struct nf_conn *ct)
+{
+       struct nf_conntrack_tuple tuple;
+       struct nf_conntrack_expect *i = NULL;
+
+
+       memset(&tuple, 0, sizeof(tuple));
+       tuple.src.l3num = AF_INET;
+       tuple.dst.protonum = IPPROTO_UDP;
+       tuple.dst.u3.ip = ip;
+       tuple.dst.u.udp.port = port;
+
+       rcu_read_lock();
+       i = __nf_ct_expect_find(nf_ct_net(ct), nf_ct_zone(ct), &tuple);
+       rcu_read_unlock();
+
+       return i != NULL;
+}
+
+#if IS_ENABLED(CONFIG_IPV6)
+static inline int find_exp6(const struct in6_addr *ip6, __be16 port, struct nf_conn *ct)
+{
+       struct nf_conntrack_tuple tuple;
+       struct nf_conntrack_expect *i = NULL;
+
+       memset(&tuple, 0, sizeof(tuple));
+       tuple.src.l3num = AF_INET6;
+       tuple.dst.protonum = IPPROTO_UDP;
+       tuple.dst.u3.in6 = *ip6;
+       tuple.dst.u.udp.port = port;
+
+       rcu_read_lock();
+       i = __nf_ct_expect_find(nf_ct_net(ct), nf_ct_zone(ct), &tuple);
+       rcu_read_unlock();
+
+       return i != NULL;
+}
+#endif
