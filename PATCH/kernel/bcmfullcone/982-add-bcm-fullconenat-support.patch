+/**
+ * nf_nat_src_mapping - lookup existing source mapping for an endpoint
+ * @net: network namespace
+ * @zone: conntrack zone
+ * @orig: original tuple of the connection
+ * @addr: destination pointer for mapped source address
+ * @port: destination pointer for mapped source port
+ *
+ * Walks nf_nat_bysource to preserve endpoint-independent mapping (RFC 4787 REQ-1).
+ * Returns true if an active mapping is found.
+ */
+bool nf_nat_src_mapping(struct net *net,
+			const struct nf_conntrack_zone *zone,
+			const struct nf_conntrack_tuple *orig,
+			union nf_inet_addr *addr, __be16 *port)
+{
+	unsigned int h;
+	const struct nf_conn *ct;
+	struct nf_conntrack_tuple result;
+
+	if (orig->dst.protonum != IPPROTO_UDP)
+		return false;
+
+	h = hash_by_src(net, zone, orig);
+
+	rcu_read_lock();
+	hlist_for_each_entry_rcu(ct, &nf_nat_bysource[h], nat_bysource) {
+		if (nf_ct_is_dying(ct) ||
+		    nf_ct_l3num(ct) != orig->src.l3num ||
+		    !same_src(ct, orig) ||
+		    !net_eq(net, nf_ct_net(ct)) ||
+		    !nf_ct_zone_equal(ct, zone, IP_CT_DIR_ORIGINAL))
+			continue;
+
+		nf_ct_invert_tuple(&result,
+				   &ct->tuplehash[IP_CT_DIR_REPLY].tuple);
+		*addr = result.src.u3;
+		*port = result.src.u.udp.port;
+		rcu_read_unlock();
+		return true;
+	}
+	rcu_read_unlock();
+
+	return false;
+}
+EXPORT_SYMBOL_GPL(nf_nat_src_mapping);
+
 /* For [FUTURE] fragmentation handling, we want the least-used
  * src-ip/dst-ip/proto triple.  Fairness doesn't come into it.  Thus
  * if the range specifies 1.2.3.4 ports 10000-10005 and 1.2.3.5 ports
@@ -1358,6 +1405,9 @@
 		kvfree(nf_nat_bysource);
 	}
 
+	if (ret == 0)
+		nf_nat_fullcone_helpers_register();
+
 	return ret;
 }
 
