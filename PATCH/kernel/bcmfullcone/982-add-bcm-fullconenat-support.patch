+/**
+ * nf_nat_src_mapping - the source mapping NAT already has for an endpoint
+ * @net: network namespace of the connection
+ * @zone: conntrack zone of the connection
+ * @orig: original tuple of the connection being set up
+ * @addr: output, the mapped source address if a live mapping exists
+ * @port: output, the mapped source port if a live mapping exists
+ *
+ * Walks nf_nat_bysource, so a new connection from an already-mapped endpoint
+ * keeps that port (RFC 4787 4.1).  Returns true and stores the mapping in
+ * @addr and @port, which the caller must reuse as a pair.
+ */
+bool nf_nat_src_mapping(struct net *net, const struct nf_conntrack_zone *zone,
+		      const struct nf_conntrack_tuple *orig,
+		      union nf_inet_addr *addr, __be16 *port)
+{
+	unsigned int h;
+	const struct nf_conn *ct;
+	struct nf_conntrack_tuple result;
+
+	if (orig->dst.protonum != IPPROTO_UDP)
+		return false;
+
+	h = hash_by_src(net, zone, orig);
+
+	rcu_read_lock();
+	hlist_for_each_entry_rcu(ct, &nf_nat_bysource[h], nat_bysource) {
+		/* same_src() does not compare l3num; a bucket collision could
+		 * otherwise match a v4 lookup against an aliasing v6 address.
+		 */
+		if (nf_ct_l3num(ct) != orig->src.l3num ||
+		    !same_src(ct, orig) ||
+		    !net_eq(net, nf_ct_net(ct)) ||
+		    !nf_ct_zone_equal(ct, zone, IP_CT_DIR_ORIGINAL))
+			continue;
+
+		/* Copy source part from reply tuple. */
+		nf_ct_invert_tuple(&result,
+				   &ct->tuplehash[IP_CT_DIR_REPLY].tuple);
+		*addr = result.src.u3;
+		*port = result.src.u.udp.port;
+		rcu_read_unlock();
+		return true;
+	}
+	rcu_read_unlock();
+
+	return false;
+}
