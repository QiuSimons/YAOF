 struct masq_dev_work {
 	struct work_struct work;
@@ -24,6 +27,511 @@
 static unsigned int masq_refcnt __read_mostly;
 static atomic_t masq_worker_count __read_mostly;
 
+static void bcm_nat_expect(struct nf_conn *ct,
+                          struct nf_conntrack_expect *exp)
+{
+       struct nf_nat_range2 range;
+
+       memset(&range, 0, sizeof(range));
+
+       /* This must be a fresh one. */
+       BUG_ON(ct->status & IPS_NAT_DONE_MASK);
+
+       /* Change src to where new ct comes from */
+       range.flags = NF_NAT_RANGE_MAP_IPS;
+       range.min_addr = range.max_addr =
+               ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.src.u3;
+       nf_nat_setup_info(ct, &range, NF_NAT_MANIP_SRC);
+
+       /* For DST manip, map port here to where it's expected. */
+       range.flags = (NF_NAT_RANGE_MAP_IPS | NF_NAT_RANGE_PROTO_SPECIFIED);
+       range.min_proto = range.max_proto = exp->saved_proto;
+       range.min_addr = range.max_addr = exp->saved_addr;
+       nf_nat_setup_info(ct, &range, NF_NAT_MANIP_DST);
+
+       /* The related connection is fully set up and carries the helper,
+        * so the software flowtable may forward it; hardware offload stays
+        * excluded.
+        */
+       set_bit(IPS_FULLCONE_BIT, &ct->status);
+}
+
+/* Build the expectation-table key for an external address and port. */
+static void bcm_nat_expect_tuple(struct nf_conntrack_tuple *tuple, u8 l3num,
+				 const void *addr, __be16 port)
+{
+	memset(tuple, 0, sizeof(*tuple));
+	tuple->src.l3num = l3num;
+	tuple->dst.protonum = IPPROTO_UDP;
+	if (l3num == AF_INET6)
+		tuple->dst.u3.in6 = *(const struct in6_addr *)addr;
+	else
+		tuple->dst.u3.ip = *(const __be32 *)addr;
+	tuple->dst.u.udp.port = port;
+}
+
+/* Install the full-cone expectation.  Shared by v4 and v6. */
+static struct nf_conntrack_expect *bcm_nat_expect_create(struct nf_conn *ct,
+                                                       u8 l3num, int dir)
+{
+       struct nf_conn_help *help = nfct_help(ct);
+       struct nf_conntrack_expect *exp;
+
+       if (help && help->expecting[NF_CT_EXPECT_CLASS_DEFAULT])
+               return NULL;
+
+       exp = nf_ct_expect_alloc(ct);
+       if (exp == NULL)
+               return NULL;
+
+       nf_ct_expect_init(exp, NF_CT_EXPECT_CLASS_DEFAULT, l3num, NULL,
+                         &ct->tuplehash[!dir].tuple.dst.u3, IPPROTO_UDP,
+                         NULL, &ct->tuplehash[!dir].tuple.dst.u.udp.port);
+       exp->flags = NF_CT_EXPECT_PERMANENT;
+       exp->saved_addr = ct->tuplehash[dir].tuple.src.u3;
+       exp->saved_proto.udp.port = ct->tuplehash[dir].tuple.src.u.udp.port;
+       exp->dir = !dir;
+       exp->expectfn = bcm_nat_expect;
+
+       if (nf_ct_expect_related(exp, 0) != 0) {
+               nf_ct_expect_put(exp);
+               return NULL;
+       }
+
+       return exp;
+}
+
+static int bcm_nat_help(struct sk_buff *skb, unsigned int protoff,
+		       struct nf_conn *ct, enum ip_conntrack_info ctinfo)
+{
+	struct nf_conn_help *help = nfct_help(ct);
+	struct nf_conntrack_expect *exp;
+	struct nf_conntrack_tuple tuple;
+	bool found;
+	int dir;
+
+	/* Only a connection this feature masqueraded owns the mapping: a
+	 * connection created from the expectation inherits exp->helper and must
+	 * not install a second expectation aimed at its peer.
+	 */
+	if (!(ct->status & IPS_FULLCONE))
+		return NF_ACCEPT;
+
+	/* A connection created from the expectation is complete: it must not
+	 * install a second expectation aimed at its peer.
+	 */
+	if (test_bit(IPS_EXPECTED_BIT, &ct->status))
+		return NF_ACCEPT;
+
+	dir = CTINFO2DIR(ctinfo);
+	if (dir != IP_CT_DIR_ORIGINAL)
+		return NF_ACCEPT;
+
+	if (help && help->expecting[NF_CT_EXPECT_CLASS_DEFAULT])
+		return NF_ACCEPT;
+
+	/* The masquerade path registered the mapping for the connection that
+	 * created it; a connection sharing that mapping has nothing registered
+	 * here.  Probe the table before allocating: the lookup is cheap, while
+	 * creating would allocate and then lose the clash against the owner.
+	 * When the owner is gone the probe misses and this connection takes the
+	 * mapping over.
+	 */
+	bcm_nat_expect_tuple(&tuple, ct->tuplehash[dir].tuple.src.l3num,
+			     &ct->tuplehash[!dir].tuple.dst.u3,
+			     ct->tuplehash[!dir].tuple.dst.u.udp.port);
+	rcu_read_lock();
+	found = __nf_ct_expect_find(nf_ct_net(ct), nf_ct_zone(ct), &tuple) != NULL;
+	rcu_read_unlock();
+	if (found)
+		return NF_ACCEPT;
+
+	exp = bcm_nat_expect_create(ct, ct->tuplehash[dir].tuple.src.l3num, dir);
+	if (exp != NULL) {
+		pr_debug("bcm_nat: expect set up\n");
+		nf_ct_expect_put(exp);
+	}
+
+	return NF_ACCEPT;
+}
+
+/* The expiry timer unlinks an expectation unconditionally (PERMANENT only
+ * stops a matching packet from consuming it), while an offloaded connection
+ * never reaches nf_confirm() to re-arm it.  Keep the timer far beyond any
+ * master conntrack lifetime: the mapping then lives exactly as long as the
+ * connection that owns it, and nf_ct_remove_expectations() frees it.
+ */
+static struct nf_conntrack_expect_policy bcm_nat_exp_policy __read_mostly = {
+	/* One mapping per connection: the masquerade path registers it once and
+	 * bcm_nat_help() never registers a second one for the same conntrack.
+	 * NF_CT_EXPECT_MAX_CNT is 255 and nf_conntrack_helper_register() refuses
+	 * any policy above it.
+	 */
+	.max_expected	= 1,
+	.timeout	= 86400,
+};
+
+
+static struct nf_conntrack_helper nf_conntrack_helper_bcm_nat __read_mostly = {
+       .name = "BCM-NAT",
+       .me = THIS_MODULE,
+       .tuple.src.l3num = AF_INET,
+       .tuple.dst.protonum = IPPROTO_UDP,
+       .expect_policy = &bcm_nat_exp_policy,
+       .expect_class_max = 1,
+       .help = bcm_nat_help,
+};
+
+#if IS_ENABLED(CONFIG_IPV6)
+static struct nf_conntrack_helper nf_conntrack_helper_bcm_nat6 __read_mostly = {
+       .name = "BCM-NAT6",
+       .me = THIS_MODULE,
+       .tuple.src.l3num = AF_INET6,
+       .tuple.dst.protonum = IPPROTO_UDP,
+       .expect_policy = &bcm_nat_exp_policy,
+       .expect_class_max = 1,
+       .help = bcm_nat_help,
+};
+#endif
+
+/* A connection is full cone when userspace attached one of our helpers to it
+ * before the masquerade ran: fw4 emits "ct helper set" right in front of the
+ * masquerade expression.  The helper name is the whole discriminator, so the
+ * nft attribute and the fake address the previous scheme carried are gone.
+ */
+static bool bcm_nat_is_fullcone(struct nf_conn *ct)
+{
+	struct nf_conn_help *help = nfct_help(ct);
+	const struct nf_conntrack_helper *h;
+
+	if (help == NULL)
+		return false;
+
+	h = rcu_dereference(help->helper);
+	return h == &nf_conntrack_helper_bcm_nat
+#if IS_ENABLED(CONFIG_IPV6)
+	       || h == &nf_conntrack_helper_bcm_nat6
+#endif
+		;
+}
+
+/* ct helper objects are resolved by name against the kernel helper table, so
+ * the full cone helpers have to be registered for userspace to attach them.
+ * A registration failure is not fatal: masquerade keeps working, full cone is
+ * just unavailable, which fw4 probes for.
+ */
+static bool bcm_nat_helper4_registered;
+#if IS_ENABLED(CONFIG_IPV6)
+static bool bcm_nat_helper6_registered;
+#endif
+
+void nf_nat_fullcone_helpers_register(void)
+{
+	bcm_nat_helper4_registered =
+		nf_conntrack_helper_register(&nf_conntrack_helper_bcm_nat) == 0;
+	if (!bcm_nat_helper4_registered)
+		pr_warn("bcm_nat: cannot register the BCM-NAT helper\n");
+#if IS_ENABLED(CONFIG_IPV6)
+	bcm_nat_helper6_registered =
+		nf_conntrack_helper_register(&nf_conntrack_helper_bcm_nat6) == 0;
+	if (!bcm_nat_helper6_registered)
+		pr_warn("bcm_nat: cannot register the BCM-NAT6 helper\n");
+#endif
+}
+
+void nf_nat_fullcone_helpers_unregister(void)
+{
+#if IS_ENABLED(CONFIG_IPV6)
+	if (bcm_nat_helper6_registered)
+		nf_conntrack_helper_unregister(&nf_conntrack_helper_bcm_nat6);
+#endif
+	if (bcm_nat_helper4_registered)
+		nf_conntrack_helper_unregister(&nf_conntrack_helper_bcm_nat);
+}
+
+/* Upper bound on expectation-table lookups per new flow; this runs under
+ * nf_conntrack_expect_lock in softirq, so the port space is never walked
+ * exhaustively.  Candidates are all of one parity (RFC 4787 REQ-4).
+ */
+#define BCM_NAT_PORT_PROBES 32
+
+/* State of the external (addr, port) in the expectation table:
+ *   0 - nobody, 1 - this endpoint's mapping, 2 - another endpoint's mapping.
+ * The table is keyed on the external address and port, so a state-2 port could
+ * not be told apart from our own mapping once installed.
+ * The caller holds rcu_read_lock(); the lookup is read-only.
+ */
+static int bcm_nat_expect_state(struct nf_conn *ct,
+				const struct nf_conntrack_tuple *orig,
+				const struct nf_conntrack_tuple *tuple)
+{
+	struct nf_conntrack_expect *i;
+	bool mine;
+	int state = 0;
+
+	i = __nf_ct_expect_find(nf_ct_net(ct), nf_ct_zone(ct), tuple);
+	if (i) {
+		mine = tuple->src.l3num == AF_INET6 ?
+			ipv6_addr_equal(&i->saved_addr.in6,
+					&orig->src.u3.in6) :
+			i->saved_addr.ip == orig->src.u3.ip;
+
+		state = (mine && i->saved_proto.udp.port ==
+			 orig->src.u.udp.port) ? 1 : 2;
+	}
+
+	return state;
+}
+
+/* The endpoint mapping belongs to whichever conntrack registered it.  An
+ * offloaded owner is exempt from the conntrack gc and outlives this
+ * connection, so it keeps the mapping; any other owner expires on its own
+ * timer and would take the mapping with it.  Move the mapping to the
+ * connection that is being set up now.
+ *
+ * Expressed conntracks do not hold a reference on their master, so the owner
+ * may only be inspected while the expectation is still in the table, i.e.
+ * inside the RCU section that found it.
+ */
+static bool bcm_nat_takeover(struct nf_conn *ct,
+			     const struct nf_conntrack_tuple *tuple)
+{
+	struct nf_conntrack_expect *exp;
+	struct nf_conn *owner = NULL;
+	bool protected = false;
+
+	rcu_read_lock();
+	exp = __nf_ct_expect_find(nf_ct_net(ct), nf_ct_zone(ct), tuple);
+	if (exp == NULL) {
+		rcu_read_unlock();
+		return true;
+	}
+
+	/* The expectation does not hold a reference on its master, so pin the
+	 * owner before looking at it, the same way nf_ct_find_expectation()
+	 * does: a failing refcount means the owner is already being destroyed.
+	 */
+	if (refcount_inc_not_zero(&exp->master->ct_general.use)) {
+		owner = exp->master;
+		if (!nf_ct_is_dying(owner))
+			protected = test_bit(IPS_OFFLOAD_BIT, &owner->status);
+	}
+	rcu_read_unlock();
+
+	if (owner == NULL)
+		return true;
+
+	if (protected) {
+		nf_ct_put(owner);
+		return false;
+	}
+
+	nf_ct_put(owner);
+
+	exp = nf_ct_expect_find_get(nf_ct_net(ct), nf_ct_zone(ct), tuple);
+	if (exp == NULL)
+		return true;
+
+	nf_ct_unexpect_related(exp);
+	nf_ct_expect_put(exp);
+
+	return true;
+}
+
+/* Pick the external port for a full-cone mapping and bind it into @newrange.
+ * Returns NF_ACCEPT with the binding in place, NF_DROP if nothing was free.
+ */
+static unsigned int bcm_nat_alloc_port(struct nf_conn *ct, u8 l3num,
+				       const struct nf_nat_range2 *range,
+				       const void *addr,
+				       struct nf_nat_range2 *newrange,
+				       const char *tag, bool *need_expect)
+{
+	const struct nf_conntrack_tuple *orig =
+		&ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple;
+	u_int16_t srcport = ntohs(orig->src.u.udp.port);
+	u_int16_t minport, maxport, minp, maxp, parity;
+	struct nf_conntrack_tuple tuple;
+	union nf_inet_addr reuse_addr;
+	__be16 reuse_port = 0;
+	unsigned int i, n = 0;
+	bool found = false;
+	__be16 cands[BCM_NAT_PORT_PROBES];
+
+	memset(newrange, 0, sizeof(*newrange));
+
+	/* An endpoint that already has a mapping keeps its port (RFC 4787
+	 * REQ-1).  It has to be committed as a narrowed range: the range the
+	 * kernel is handed would not contain it and get_unique_tuple() would
+	 * allocate a second port for the same endpoint.
+	 */
+	if (nf_nat_src_mapping(nf_ct_net(ct), nf_ct_zone(ct), orig, &reuse_addr,
+			       &reuse_port) &&
+	    reuse_port != 0) {
+		bool same_addr = (l3num == AF_INET6) ?
+			ipv6_addr_equal(&reuse_addr.in6,
+					(const struct in6_addr *)addr) :
+			reuse_addr.ip == *(const __be32 *)addr;
+
+		/* The endpoint has a mapping, but not necessarily on the address
+		 * this packet leaves through: with multiple WANs or a changed
+		 * address, reusing it would put a foreign source address on the
+		 * wire.
+		 */
+		if (same_addr) {
+			int state;
+
+			bcm_nat_expect_tuple(&tuple, l3num, &reuse_addr, reuse_port);
+			rcu_read_lock();
+			state = bcm_nat_expect_state(ct, orig, &tuple);
+			rcu_read_unlock();
+
+			/* A port owned by another endpoint must not be reused. */
+			if (state == 2)
+				return NF_DROP;
+
+			/* state 1: a live expectation covers this endpoint; keep it
+			 * unless its owner is about to go away.
+			 * state 0: the expectation died with the conntrack that owned it
+			 * (nf_ct_remove_expectations() drops it with its master), so the
+			 * port is bound but unreachable and has to be registered again.
+			 */
+			if (state == 1)
+				*need_expect = bcm_nat_takeover(ct, &tuple);
+			else
+				*need_expect = true;
+
+			minport = maxport = reuse_port;
+			if (l3num == AF_INET6)
+				newrange->min_addr.in6 = newrange->max_addr.in6 =
+					reuse_addr.in6;
+			else
+				newrange->min_addr.ip = newrange->max_addr.ip =
+					reuse_addr.ip;
+			newrange->flags = range->flags | NF_NAT_RANGE_MAP_IPS |
+				NF_NAT_RANGE_PROTO_SPECIFIED;
+			newrange->min_proto.udp.port =
+				newrange->max_proto.udp.port = reuse_port;
+			return NF_ACCEPT;
+		}
+	}
+
+	minport = range->min_proto.all;
+	maxport = range->max_proto.all;
+	if (minport == 0) {
+		/* No range in the rule: follow the convention the kernel uses for
+		 * a source rewrite.  Starting at the internal port would leave
+		 * only the few ports above a high one available.
+		 */
+		if (srcport < 512) {
+			minport = htons(1);
+			maxport = htons(511);
+		} else if (srcport < 1024) {
+			minport = htons(600);
+			maxport = htons(1023);
+		} else {
+			minport = htons(1024);
+			maxport = htons(65535);
+		}
+	} else if (maxport == 0) {
+		maxport = htons(65535);
+	}
+	minp = ntohs(minport);
+	maxp = ntohs(maxport);
+	parity = srcport & 1;
+
+	if (minp <= maxp) {
+		/* The source port parity has to be kept (RFC 4787 REQ-4), so the
+		 * candidates are one arithmetic sequence with a step of two.
+		 */
+		u32 first = minp + ((parity ^ (minp & 1)) ? 1 : 0);
+		u32 cnt = (first <= maxp) ? (maxp - first) / 2 + 1 : 0;
+		u32 idx = cnt ? get_random_u16() % cnt : 0;
+		bool have_src = false;
+
+		/* internal port first: port preservation (RFC 4787 REQ-3) */
+		if (srcport >= minp && srcport <= maxp &&
+		    (srcport & 1) == parity) {
+			cands[n++] = htons(srcport);
+			have_src = true;
+		}
+
+		for (i = 0; i < cnt && n < BCM_NAT_PORT_PROBES; i++) {
+			u32 d = (i + 1) >> 1;
+			u32 j = (i & 1) ? (idx + cnt - d) % cnt :
+					 (idx + d) % cnt;
+			u_int16_t c = first + 2 * j;
+
+			if (have_src && c == srcport)
+				continue;
+			cands[n++] = htons(c);
+		}
+	}
+
+	/* One RCU section for the whole scan: the expectation hash is read
+	 * only, and nf_ct_expect_related() takes the lock for the insert.
+	 */
+	bcm_nat_expect_tuple(&tuple, l3num, addr, 0);
+	rcu_read_lock();
+	for (i = 0; i < n; i++) {
+		tuple.dst.u.udp.port = cands[i];
+		if (bcm_nat_expect_state(ct, orig, &tuple) == 2)
+			cands[i] = 0;
+	}
+	rcu_read_unlock();
+
+	/* A clash with an unrelated mapping is left to nf_conntrack_confirm(),
+	 * the same mechanism plain masquerade relies on.
+	 */
+	for (i = 0; i < n; i++) {
+		if (cands[i] == 0)
+			continue;
+		minport = maxport = cands[i];
+		found = true;
+		break;
+	}
+
+	if (!found) {
+		pr_debug("%s: no free port in [%hu,%hu]\n", tag, minp, maxp);
+		return NF_DROP;
+	}
+
+	*need_expect = true;
+
+	if (l3num == AF_INET6)
+		newrange->min_addr.in6 = newrange->max_addr.in6 =
+			*(const struct in6_addr *)addr;
+	else
+		newrange->min_addr.ip = newrange->max_addr.ip =
+			*(const __be32 *)addr;
+
+	newrange->flags = range->flags | NF_NAT_RANGE_MAP_IPS |
+		NF_NAT_RANGE_PROTO_SPECIFIED;
+	newrange->min_proto.udp.port = newrange->max_proto.udp.port = minport;
+
+	return NF_ACCEPT;
+}
+
+/* Register the expectation.  The helper is already on the connection: fw4
+ * attaches it with "ct helper set" in front of the masquerade expression.
+ */
+static int bcm_nat_install_expect(struct nf_conn *ct, u8 l3num, const char *tag)
+{
+	struct nf_conntrack_expect *exp;
+
+	exp = bcm_nat_expect_create(ct, l3num, IP_CT_DIR_ORIGINAL);
+	if (exp == NULL) {
+		/* Nothing can reach this mapping from the outside: do not keep
+		 * it, let the client retransmit into a new port.
+		 */
+		pr_debug("%s: expectation failed, dropping\n", tag);
+		return -ENOMEM;
+	}
+	nf_ct_expect_put(exp);
+
+	return 0;
+}
