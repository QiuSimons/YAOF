+/* Upper bound on expectation-table lookups per new flow; this runs under
+ * nf_conntrack_expect_lock in softirq, so the port space is never walked
+ * exhaustively.  Candidates are all of one parity (RFC 4787 REQ-4).
+ */
+#define BCM_NAT_PORT_PROBES 32
+
+/* State of an external (addr, port) in the expectation table:
+ *   0 - nobody, 1 - this endpoint's mapping, 2 - another endpoint's mapping.
+ * The table is keyed on the external address and port, so a state-2 port could
+ * not be told apart from our own mapping once installed.
+ */
+static int bcm_nat_expect_state(struct nf_conn *ct, u8 l3num,
+				const struct nf_conntrack_tuple *orig,
+				const void *addr, __be16 port)
+{
+	struct nf_conntrack_tuple tuple;
+	struct nf_conntrack_expect *i;
+	int state = 0;
+
+	memset(&tuple, 0, sizeof(tuple));
+	tuple.src.l3num = l3num;
+	tuple.dst.protonum = IPPROTO_UDP;
+	if (l3num == AF_INET6)
+		tuple.dst.u3.in6 = *(const struct in6_addr *)addr;
+	else
+		tuple.dst.u3.ip = *(const __be32 *)addr;
+	tuple.dst.u.udp.port = port;
+
+	rcu_read_lock();	/* saved_* must be read under RCU: the pointer
+				 * returned by __nf_ct_expect_find() is not
+				 * stable once the section ends
+				 */
+	i = __nf_ct_expect_find(nf_ct_net(ct), nf_ct_zone(ct), &tuple);
+	if (i) {
+		bool mine = l3num == AF_INET6 ?
+			ipv6_addr_equal(&i->saved_addr.in6,
+					&orig->src.u3.in6) :
+			i->saved_addr.ip == orig->src.u3.ip;
+
+		if (mine && i->saved_proto.udp.port == orig->src.u.udp.port) {
+			state = 1;
+			/* The expiry callback unlinks the expectation
+			 * unconditionally (PERMANENT only stops a matching
+			 * packet from consuming it), so an active endpoint
+			 * would lose its port after the timeout.  Re-arm only
+			 * while the timer is pending, i.e. while the
+			 * expectation is not being torn down.
+			 */
+			if (timer_pending(&i->timeout))
+				mod_timer(&i->timeout, jiffies +
+					  bcm_nat_exp_policy.timeout * HZ);
+		} else {
+			state = 2;
+		}
+	}
+	rcu_read_unlock();
+
+	return state;
+}
+
+
+/* Pick the external port for a full-cone mapping and bind it into @newrange.
+ * Returns NF_ACCEPT with the binding in place, NF_DROP if nothing was free.
+ */
+static unsigned int bcm_nat_alloc_port(struct nf_conn *ct, u8 l3num,
+				       const struct nf_nat_range2 *range,
+				       const void *addr,
+				       struct nf_nat_range2 *newrange,
+				       const char *tag, bool *need_expect)
+{
+	const struct nf_conntrack_tuple *orig =
+		&ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple;
+	u_int16_t srcport = ntohs(orig->src.u.udp.port);
+	u_int16_t minport, maxport, minp, maxp, parity, start, span;
+	union nf_inet_addr reuse_addr;
+	__be16 reuse_port = 0;
+	unsigned int i, n = 0;
+	bool found = false;
+	__be16 cands[BCM_NAT_PORT_PROBES];
+
+	/* An endpoint that already has a mapping keeps its port (RFC 4787
+	 * REQ-1).  It has to be committed as a narrowed range: the range the
+	 * kernel is handed would not contain it and get_unique_tuple() would
+	 * allocate a second port for the same endpoint.
+	 */
+	if (nf_nat_src_mapping(nf_ct_net(ct), nf_ct_zone(ct), orig, &reuse_addr,
+			       &reuse_port) &&
+	    reuse_port != 0) {
+		int state = bcm_nat_expect_state(ct, l3num, orig, &reuse_addr,
+						 reuse_port);
+
+		/* A port owned by another endpoint must not be reused. */
+		if (state == 2)
+			return NF_DROP;
+
+		/* state 1: a live expectation covers this endpoint (its timer
+		 * was refreshed above) and a second one would fail with -EBUSY,
+		 * because its master is a different conntrack.
+		 * state 0: the expectation died with the conntrack that owned it
+		 * (nf_ct_remove_expectations() drops it with its master), so the
+		 * port is bound but unreachable and has to be registered again.
+		 */
+		*need_expect = (state == 0);
+
+		minport = maxport = reuse_port;
+		if (l3num == AF_INET6)
+			newrange->min_addr.in6 = newrange->max_addr.in6 =
+				reuse_addr.in6;
+		else
+			newrange->min_addr.ip = newrange->max_addr.ip =
+				reuse_addr.ip;
+		newrange->flags = range->flags | NF_NAT_RANGE_MAP_IPS |
+			NF_NAT_RANGE_PROTO_SPECIFIED;
+		newrange->min_proto.udp.port =
+			newrange->max_proto.udp.port = reuse_port;
+		return NF_ACCEPT;
+	}
+
+	spin_lock_bh(&nf_conntrack_expect_lock);
+	{
+		minport = range->min_proto.all == 0 ? orig->src.u.udp.port :
+			range->min_proto.all;
+		maxport = range->max_proto.all == 0 ? htons(65535) :
+			range->max_proto.all;
+		minp = ntohs(minport);
+		maxp = ntohs(maxport);
+		parity = srcport & 1;
+
+		if (minp <= maxp) {
+			span = (u_int16_t)(maxp - minp + 1);
+			/* keep the source port parity (RFC 4787 REQ-4) */
+			start = minp + (get_random_u16() % span);
+			start |= (u_int16_t)(parity ^ (start & 1));
+			for (i = 0; i < BCM_NAT_PORT_PROBES; i++) {
+				u_int16_t c;
+
+				if (i & 1) {
+					if (start - (i >> 1) < minp)
+						continue;
+					c = start - (i >> 1);
+				} else {
+					c = minp +
+					    ((start - minp + (i >> 1)) % span);
+				}
+				if ((c & 1) != parity)
+					continue;
+				cands[n] = htons(c);
+				if (++n == BCM_NAT_PORT_PROBES)
+					break;
+			}
+			/* internal port first: port preservation */
+			if (srcport >= minp && srcport <= maxp &&
+			    (srcport & 1) == parity &&
+			    n < BCM_NAT_PORT_PROBES) {
+				for (i = n; i > 0; i--)
+					cands[i] = cands[i - 1];
+				cands[0] = htons(srcport);
+				n++;
+			}
+		}
+
+		for (i = 0; i < n; i++)
+			if (bcm_nat_expect_state(ct, l3num, orig, addr,
+						 cands[i]) == 2)
+				cands[i] = 0;
+	}
+	spin_unlock_bh(&nf_conntrack_expect_lock);
+
+	/* A clash with an unrelated mapping is left to nf_conntrack_confirm(),
+	 * the same mechanism plain masquerade relies on.
+	 */
+	for (i = 0; i < n; i++) {
+		if (cands[i] == 0)
+			continue;
+		minport = maxport = cands[i];
+		found = true;
+		break;
+	}
+
+	if (!found) {
+		pr_debug("%s: no free port in [%hu,%hu]\n", tag, minp, maxp);
+		return NF_DROP;
+	}
+
+	*need_expect = true;
+
+	if (l3num == AF_INET6)
+		newrange->min_addr.in6 = newrange->max_addr.in6 =
+			*(const struct in6_addr *)addr;
+	else
+		newrange->min_addr.ip = newrange->max_addr.ip =
+			*(const __be32 *)addr;
+
+	newrange->flags = range->flags | NF_NAT_RANGE_MAP_IPS |
+		NF_NAT_RANGE_PROTO_SPECIFIED;
+	newrange->min_proto.udp.port = newrange->max_proto.udp.port = minport;
+
+	return NF_ACCEPT;
+}
+
+/* Publish the helper, then register the expectation. */
+
+static int bcm_nat_install_expect(struct nf_conn *ct, u8 l3num,
+				  struct nf_conntrack_helper *helper,
+				  const char *tag)
+{
+	struct nf_conntrack_expect *exp;
+	struct nf_conn_help *help = nfct_help(ct);
+
+	if (help == NULL)
+		help = nf_ct_helper_ext_add(ct, GFP_ATOMIC);
+	if (help == NULL)
+		return -ENOMEM;
+
+	/* nf_ct_expect_init() copies the helper from here and
+	 * nf_ct_expect_insert() reads it as an RCU pointer.
+	 */
+	rcu_assign_pointer(help->helper, helper);
+
+	exp = bcm_nat_expect_create(ct, l3num, IP_CT_DIR_ORIGINAL);
+	if (exp == NULL) {
+		/* Nothing can reach this mapping from the outside: do not keep
+		 * it, let the client retransmit into a new port.
+		 */
+		RCU_INIT_POINTER(help->helper, NULL);
+		pr_debug("%s: expectation failed, dropping\n", tag);
+		return -ENOMEM;
+	}
+	nf_ct_expect_put(exp);
+
+	return 0;
+}
