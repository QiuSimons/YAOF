+/****************************************************************************/
+/*
+ * Which internal endpoint owns this external port?
+ *   0 - nobody: the port is free
+ *   1 - this connection's internal endpoint: reuse it
+ *   2 - a different internal endpoint: the table is keyed on (external
+ *       address, port) alone, so the two cannot be told apart
+ */
+static inline int exp_port_state(__be32 ip, __be16 port,
+                                 const struct nf_conntrack_tuple *orig,
+                                 struct nf_conn *ct)
+{
+        struct nf_conntrack_tuple tuple;
+        struct nf_conntrack_expect *i;
+        int state = 0;
+
+        memset(&tuple, 0, sizeof(tuple));
+        tuple.src.l3num = AF_INET;
+        tuple.dst.protonum = IPPROTO_UDP;
+        tuple.dst.u3.ip = ip;
+        tuple.dst.u.udp.port = port;
+
+        rcu_read_lock();        /* saved_* must be read inside the RCU section:
+                                 * the pointer returned by __nf_ct_expect_find()
+                                 * is not stable once the section ends */
+        i = __nf_ct_expect_find(nf_ct_net(ct), nf_ct_zone(ct), &tuple);
+        if (i) {
+                if (i->saved_addr.ip == orig->src.u3.ip &&
+                    i->saved_proto.udp.port == orig->src.u.udp.port) {
+                        /* Do not re-arm a detached timer: the expectation is being freed. */
+                        if (timer_pending(&i->timeout))
+                                mod_timer(&i->timeout,
+                                          jiffies + bcm_nat_exp_policy.timeout * HZ);
+                        state = 1;
+                } else {
+                        state = 2;
+                }
+        }
+        rcu_read_unlock();
+
+        return state;
+}
+
+#if IS_ENABLED(CONFIG_IPV6)
+/* IPv6 twin of exp_port_state(). */
+static inline int exp_port_state6(const struct in6_addr *ip6, __be16 port,
+                                  const struct nf_conntrack_tuple *orig,
+                                  struct nf_conn *ct)
+{
+        struct nf_conntrack_tuple tuple;
+        struct nf_conntrack_expect *i;
+        int state = 0;
+
+        memset(&tuple, 0, sizeof(tuple));
+        tuple.src.l3num = AF_INET6;
+        tuple.dst.protonum = IPPROTO_UDP;
+        tuple.dst.u3.in6 = *ip6;
+        tuple.dst.u.udp.port = port;
+
+        rcu_read_lock();        /* saved_* must be read inside the RCU section:
+                                 * the pointer returned by __nf_ct_expect_find()
+                                 * is not stable once the section ends */
+        i = __nf_ct_expect_find(nf_ct_net(ct), nf_ct_zone(ct), &tuple);
+        if (i) {
+                if (ipv6_addr_equal(&i->saved_addr.in6,
+                                    &orig->src.u3.in6) &&
+                    i->saved_proto.udp.port == orig->src.u.udp.port) {
+                        /* Do not re-arm a detached timer: the expectation is being freed. */
+                        if (timer_pending(&i->timeout))
+                                mod_timer(&i->timeout,
+                                          jiffies + bcm_nat_exp_policy.timeout * HZ);
+                        state = 1;
+                } else {
+                        state = 2;
+                }
+        }
+        rcu_read_unlock();
+
+        return state;
+}
+#endif
