+/* Register the expectation.  The helper is already on the connection: fw4
+ * attaches it with "ct helper set" in front of the masquerade expression.
+ */
+static int bcm_nat_install_expect(struct nf_conn *ct, u8 l3num, const char *tag)
+{
+	struct nf_conntrack_expect *exp;
+	int err = -ENOMEM;
+
+	exp = bcm_nat_expect_create(ct, l3num, IP_CT_DIR_ORIGINAL, &err);
+	if (exp == NULL) {
+		pr_debug("%s: expectation failed (%d)\n", tag, err);
+		return err;
+	}
+	nf_ct_expect_put(exp);
+
+	return 0;
+}
